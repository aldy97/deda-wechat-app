{
  "name": "deda-wechat-app",
  "version": "1.0.0",
  "description": "微信原生小程序 + TypeScript 最小脚手架（设备管控、学习数据、对话记录）",
  "main": "miniprogram/app.ts",
  "scripts": {
    "dev": "echo '请使用微信开发者工具导入项目并开启热更新预览'",
    "build:npm": "echo '请在微信开发者工具中执行：工具 -> 构建 npm'",
    "test": "jest",
    "prepare": "husky",
    "pre-commit": "cd miniprogram && npx tsc --noEmit"
  },
  "lint-staged": {
    "*.{ts,js,wxml,wxss,json,md}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "wechat-miniprogram",
    "typescript",
    "vant-weapp"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@vant/weapp": "^1.11.7"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.5.1",
    "miniprogram-api-typings": "^4.0.4",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3"
  }
}
