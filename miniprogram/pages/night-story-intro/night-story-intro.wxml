<view class="night-story-page">
  <!-- 顶部 hero：背景图走远端展示位 night-story-intro/hero-bg，未命中透出渐变兜底 -->
  <view class="night-story-hero" style="height: {{ heroHeight }}rpx;">
    <!-- empty-fallback 是仓库级 fallback 闸口的显式豁免：本页用渐变兜底，不留包内占位图 -->
    <elly-image
      class="night-story-hero__bg"
      asset-key="night-story-intro/hero-bg"
      fallback=""
      empty-fallback="{{ true }}"
      mode="aspectFill"
      lazy-load="{{ false }}"
      bind:load="onHeroImageLoad"
    />
  </view>

  <view class="night-story-body">
    <text class="night-story-hero-title">{{ heroTitle }}</text>

    <view class="night-story-intro">
      <text
        wx:for="{{ introParagraphs }}"
        wx:key="*this"
        class="night-story-paragraph"
      >{{ item }}</text>
    </view>

    <view
      class="night-story-section"
      wx:for="{{ sections }}"
      wx:key="title"
    >
      <text class="night-story-section-title">{{ item.title }}</text>
      <text class="night-story-paragraph">{{ item.body }}</text>
    </view>
  </view>
</view>
