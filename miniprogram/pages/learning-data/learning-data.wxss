.learning-data-page {
  padding-bottom: 48rpx;
}

/* 时间范围切换 */
.range-tabs {
  margin-bottom: 24rpx;
}

/* 家庭总览卡 */
.overview {
  display: flex;
  flex-wrap: wrap;
  padding: 32rpx 0;
}

.overview-item {
  width: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
  box-sizing: border-box;
}

.overview-value {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--primary-color);
}

.overview-label {
  font-size: 24rpx;
  margin-top: 8rpx;
}

.section {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 24rpx;
}

.section-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-subtitle {
  font-size: 24rpx;
}

.section-title-with-margin {
  margin-top: 16rpx;
}

.trend-caption {
  font-size: 24rpx;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}

/* 智能洞察 */
.insights-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.insight-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background-color: #f7f8fa;
}

.insight-strength {
  background-color: #f0f9eb;
}

.insight-strength .insight-icon {
  color: #07c160;
}

.insight-weakness {
  background-color: #fdf6ec;
}

.insight-weakness .insight-icon {
  color: #ff976a;
}

.insight-suggestion {
  background-color: #ecf9ff;
}

.insight-suggestion .insight-icon {
  color: #1989fa;
}

.insight-milestone {
  background-color: #fef0f0;
}

.insight-milestone .insight-icon {
  color: #ee0a24;
}

.insight-alert {
  background-color: #fef0f0;
}

.insight-alert .insight-icon {
  color: #ee0a24;
}

.insight-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.insight-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
}

.insight-text {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
}

/* 学习健康度 */
.health-section {
  padding-bottom: 36rpx;
}

.health-level {
  font-size: 28rpx;
  font-weight: 600;
}

.health-level-excellent {
  color: #07c160;
}

.health-level-good {
  color: #1989fa;
}

.health-level-average {
  color: #ff976a;
}

.health-level-attention {
  color: #ee0a24;
}

.health-score-wrap {
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-bottom: 28rpx;
}

.health-ring {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 12rpx solid #e6f7ff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.health-score {
  font-size: 48rpx;
  font-weight: 700;
  color: #1989fa;
}

.health-score-label {
  font-size: 22rpx;
  color: #999999;
}

.health-suggestion {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
}

.health-dimensions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.health-dimension {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.dimension-label {
  width: 120rpx;
  font-size: 26rpx;
  flex-shrink: 0;
}

.health-dimension van-progress {
  flex: 1;
}

/* 设备汇总卡 */
.device-summary-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.summary-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.summary-left {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.summary-child-row {
  display: flex;
  align-items: center;
  margin-bottom: 4rpx;
  min-width: 0;
}

.summary-child-cn {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.summary-child-en {
  font-size: 24rpx;
  color: #999999;
  margin-left: 12rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.summary-device {
  font-size: 24rpx;
}

.summary-metrics {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.summary-metric {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 25%;
}

.summary-value {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--primary-color);
}

.summary-label {
  font-size: 22rpx;
  margin-top: 4rpx;
}

.summary-action {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-text {
  font-size: 26rpx;
}

/* 主题分布 */
.topic-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.topic-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.topic-item:last-child {
  border-bottom: none;
}

.topic-main {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.topic-name-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}

.topic-name {
  font-size: 28rpx;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

.topic-active .topic-name {
  color: var(--primary-color);
  font-weight: 500;
}

.topic-current-tag {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  height: 32rpx;
  padding: 0 12rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  color: #07c160;
  background-color: rgba(7, 193, 96, 0.1);
}

.topic-count {
  font-size: 24rpx;
  flex-shrink: 0;
}

/* 时间线 */
/* 时间线 */
.timeline-days {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  margin-bottom: 24rpx;
}

.timeline-day-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.timeline-device-groups {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.timeline-device-group {
  padding: 0;
  overflow: hidden;
}

.timeline-device-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background-color: #fafafa;
}

.timeline-device-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.timeline-device-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: #e8f4ff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.timeline-device-names {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.timeline-device-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.timeline-device-duration {
  font-size: 24rpx;
}

.timeline-device-arrow {
  transition: transform 0.25s ease;
  flex-shrink: 0;
}

.timeline-device-arrow.expanded {
  transform: rotate(180deg);
}

.timeline-device-events {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
}

.timeline-device-events.expanded {
  max-height: 2000rpx;
}

.timeline-event {
  padding: 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.timeline-event-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.timeline-event-topic {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
}

.timeline-event-time {
  font-size: 24rpx;
  flex-shrink: 0;
}

.timeline-event-text {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.timeline-event-ai {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
}

/* Skeleton */
.trend-skeleton,
.topic-skeleton,
.device-skeleton,
.timeline-skeleton,
.insights-skeleton,
.health-skeleton {
  padding: 16rpx 0;
}

/* 主题分布 meta */
.topic-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  flex-shrink: 0;
}

.topic-score {
  font-size: 24rpx;
}

.empty-tip {
  display: block;
  text-align: center;
  padding: 32rpx 0;
  font-size: 26rpx;
}

.no-more {
  display: block;
  text-align: center;
  padding: 32rpx 0;
}
