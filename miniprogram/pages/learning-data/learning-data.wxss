.learning-data-page {
  padding-bottom: 48rpx;
}

.overview {
  display: flex;
  flex-wrap: wrap;
  padding: 32rpx 0;
}

.overview-item {
  width: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
  box-sizing: border-box;
}

.overview-value {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--primary-color);
}

.overview-label {
  font-size: 24rpx;
  margin-top: 8rpx;
}

.section {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 24rpx;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}

/* 趋势图 */
.trend-chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 200rpx;
  padding: 0 8rpx;
}

.trend-bar-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
}

.trend-bar {
  width: 24rpx;
  background: linear-gradient(180deg, #07c160 0%, #8ce6b0 100%);
  border-radius: 8rpx 8rpx 0 0;
  min-height: 4rpx;
}

.trend-date {
  font-size: 20rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* 设备汇总卡 */
.device-summary-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.summary-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.summary-left {
  display: flex;
  flex-direction: column;
}

.summary-child {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.summary-device {
  font-size: 24rpx;
}

.summary-metrics {
  display: flex;
  justify-content: space-between;
}

.summary-metric {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 25%;
}

.summary-value {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--primary-color);
}

.summary-label {
  font-size: 22rpx;
  margin-top: 4rpx;
}

/* 主题分布 */
.topic-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.topic-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.topic-item:last-child {
  border-bottom: none;
}

.topic-main {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.topic-name {
  font-size: 28rpx;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.topic-active {
  color: var(--primary-color);
  font-weight: 500;
}

.topic-count {
  font-size: 24rpx;
  flex-shrink: 0;
}

/* 时间线 */
.timeline-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.timeline-item {
  display: flex;
  padding: 24rpx;
}

.timeline-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: var(--primary-color);
  margin-right: 20rpx;
  margin-top: 8rpx;
  flex-shrink: 0;
}

.timeline-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.timeline-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.timeline-topic {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
}

.timeline-device {
  font-size: 22rpx;
}

.timeline-text {
  font-size: 28rpx;
  line-height: 1.5;
  color: #333333;
}

.timeline-ai {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
  margin-top: 4rpx;
  margin-bottom: 8rpx;
}

.timeline-time {
  font-size: 24rpx;
}

.empty-tip {
  display: block;
  text-align: center;
  padding: 32rpx 0;
  font-size: 26rpx;
}

.no-more {
  display: block;
  text-align: center;
  padding: 32rpx 0;
}
