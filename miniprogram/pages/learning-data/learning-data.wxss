.learning-data-page {
  min-height: 100vh;
  padding-top: 32rpx;
  padding-bottom: 56rpx;
  background: var(--color-bg);
  box-sizing: border-box;
}

.report-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 32rpx;
  padding: 0 4rpx;
}

.heading-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.heading-title {
  color: var(--color-title);
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.3;
}

.device-switch-wrap {
  position: relative;
  flex-shrink: 0;
}

.device-switch-wrap-open {
  z-index: 42;
}

.device-switch {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 128rpx;
  max-width: 220rpx;
  min-height: 72rpx;
  margin: 0;
  padding: 12rpx 20rpx;
  border: 0;
  border-radius: 36rpx;
  background: var(--color-brand-light);
  color: var(--color-primary);
  font-size: 24rpx;
  line-height: 1.3;
}

.device-switch::after,
.feedback-button::after,
.retry-button::after {
  border: 0;
}

.device-switch-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.device-switch-arrow {
  flex-shrink: 0;
  box-sizing: border-box;
  width: 12rpx;
  height: 12rpx;
  margin-left: 12rpx;
  border-right: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: translateY(-3rpx) rotate(45deg);
}

.device-switch-arrow-open {
  transform: translateY(3rpx) rotate(225deg);
}

.device-dropdown-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 40;
  background: transparent;
}

.device-dropdown {
  position: absolute;
  top: calc(100% + 8rpx);
  right: 0;
  overflow: hidden;
  width: 264rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 20rpx;
  background: var(--color-surface);
  box-shadow: 0 16rpx 40rpx var(--color-shadow);
}

.device-dropdown-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  color: var(--color-text);
  font-size: 28rpx;
}

.device-dropdown-item + .device-dropdown-item {
  border-top: 1rpx solid var(--color-divider);
}

.device-dropdown-item-selected {
  background: var(--color-brand-light);
  color: var(--color-primary);
}

.device-dropdown-item-hover {
  background: var(--color-bg);
}

.device-dropdown-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.device-dropdown-check {
  flex-shrink: 0;
  margin-left: 16rpx;
  color: var(--color-primary);
  font-size: 30rpx;
  font-weight: 600;
}

.report-section {
  margin-bottom: 28rpx;
  padding: 30rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 28rpx var(--color-shadow);
}

.section-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.section-title,
.section-subtitle {
  display: block;
}

.section-title {
  color: var(--color-heading);
  font-size: 32rpx;
  font-weight: 650;
  line-height: 1.4;
}

.section-subtitle {
  margin-top: 6rpx;
  color: var(--color-secondary);
  font-size: 23rpx;
}

.section-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.usage-help {
  display: flex;
  flex: 0 0 40rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 40rpx;
  max-width: 40rpx;
  height: 40rpx;
  min-height: 40rpx;
  margin: 0;
  padding: 0;
  border: 2rpx solid var(--color-placeholder);
  border-radius: 50%;
  background: var(--color-surface);
  color: var(--color-secondary);
  font-size: 24rpx;
  line-height: 1;
}

.usage-help::after {
  border: 0;
}

.trend-chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 270rpx;
  padding: 12rpx 4rpx 0;
}

.trend-item {
  display: flex;
  align-items: center;
  width: 13%;
  height: 100%;
  flex-direction: column;
}

.trend-value {
  height: 34rpx;
  color: var(--color-body);
  font-size: 22rpx;
  line-height: 34rpx;
}

.trend-track {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  width: 100%;
  height: 194rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.trend-bar {
  width: 34rpx;
  min-height: 4rpx;
  border-radius: 17rpx 17rpx 4rpx 4rpx;
  background: var(--color-brand);
  transition: height 480ms cubic-bezier(0.22, 1, 0.36, 1);
}

.trend-bar-empty {
  background: var(--color-disabled);
}

.trend-label {
  margin-top: 12rpx;
  color: var(--color-secondary);
  font-size: 20rpx;
  white-space: nowrap;
}

.usage-chart {
  display: flex;
  flex-direction: column;
}

.usage-pie {
  display: block;
  width: 208rpx;
  height: 208rpx;
  margin: 8rpx auto 40rpx;
  border-radius: 50%;
  background: var(--color-divider);
}

.usage-list {
  display: flex;
  flex-direction: column;
}

.usage-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  border-bottom: 1rpx solid var(--color-divider);
}

.usage-row:last-child {
  border-bottom: 0;
}

.usage-name-wrap,
.usage-numbers {
  display: flex;
  align-items: center;
  min-width: 0;
}

.usage-dot {
  width: 16rpx;
  height: 16rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.usage-name {
  overflow: hidden;
  max-width: 260rpx;
  color: var(--color-text);
  font-size: 27rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.usage-percent {
  min-width: 72rpx;
  color: var(--color-body);
  font-size: 26rpx;
  font-weight: 600;
  text-align: right;
}

.usage-count {
  min-width: 88rpx;
  margin-left: 18rpx;
  color: var(--color-secondary);
  font-size: 23rpx;
  text-align: right;
}

.observation-row {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}

.observation-index {
  width: 58rpx;
  padding-top: 4rpx;
  color: var(--color-icon);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  flex-shrink: 0;
}

.observation-content {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.observation-title {
  margin-bottom: 10rpx;
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 600;
}

.observation-text {
  color: var(--color-body);
  font-size: 27rpx;
  line-height: 1.75;
  word-break: break-word;
}

.suggestion-box {
  margin-top: 26rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: var(--color-accent-bg);
}

.suggestion-title,
.suggestion-text {
  display: block;
}

.suggestion-title {
  margin-bottom: 10rpx;
  color: var(--color-accent-dark);
  font-size: 27rpx;
  font-weight: 600;
}

.suggestion-text {
  color: var(--color-accent-text);
  font-size: 27rpx;
  line-height: 1.75;
  word-break: break-word;
}

.feedback-block {
  margin-top: 30rpx;
  text-align: center;
}

.feedback-question {
  display: block;
  margin-bottom: 18rpx;
  color: var(--color-body);
  font-size: 25rpx;
}

.feedback-actions {
  display: flex;
  gap: 20rpx;
}

.feedback-button {
  flex: 1;
  min-height: 80rpx;
  margin: 0;
  border: 1rpx solid var(--color-border);
  border-radius: 40rpx;
  background: var(--color-surface);
  color: var(--color-body);
  font-size: 27rpx;
  line-height: 78rpx;
}

.feedback-thanks {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80rpx;
  color: var(--color-primary);
  font-size: 27rpx;
  font-weight: 600;
}

.summary-empty,
.empty-device,
.empty-state,
.section-error {
  display: flex;
  align-items: center;
  flex-direction: column;
  text-align: center;
}

.summary-empty {
  padding: 32rpx 20rpx 40rpx;
}

.summary-empty-title,
.empty-device-title {
  color: var(--color-body);
  font-size: 29rpx;
  font-weight: 600;
}

.summary-empty-copy,
.empty-device-copy {
  margin-top: 12rpx;
  color: var(--color-secondary);
  font-size: 25rpx;
  line-height: 1.7;
}

.empty-device {
  padding: 88rpx 40rpx;
}

.empty-state {
  justify-content: center;
  min-height: 220rpx;
}

.empty-chart-icon {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 10rpx;
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 20rpx;
  padding-bottom: 24rpx;
  border-radius: 50%;
  background: var(--color-brand-light);
  box-sizing: border-box;
}

.empty-chart-icon i {
  width: 12rpx;
  height: 24rpx;
  border-radius: 8rpx;
  background: var(--color-icon);
}

.empty-chart-icon i:nth-child(2) {
  height: 40rpx;
}

.empty-chart-icon i:nth-child(3) {
  height: 32rpx;
}

.empty-report-icon,
.pending-icon {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 20rpx;
  border-radius: 50%;
  background: var(--color-brand-light);
}

.empty-report-icon::before,
.pending-icon::before {
  position: absolute;
  top: 32rpx;
  left: 28rpx;
  width: 40rpx;
  height: 28rpx;
  border: 4rpx solid var(--color-icon);
  border-radius: 8rpx;
  content: "";
  box-sizing: border-box;
}

.empty-report-icon::after,
.pending-icon::after {
  position: absolute;
  top: 44rpx;
  left: 38rpx;
  width: 24rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: var(--color-icon);
  content: "";
}

.pending-icon-quiet {
  background: var(--color-brand-light);
}

.ai-disclaimer {
  display: block;
  margin-top: 28rpx;
  color: var(--color-secondary);
  font-size: 20rpx;
  line-height: 1.6;
  text-align: center;
}

.empty-tip {
  display: block;
  color: var(--color-secondary);
  font-size: 25rpx;
  text-align: center;
}

.section-error {
  justify-content: center;
  min-height: 180rpx;
  gap: 20rpx;
  color: var(--color-secondary);
  font-size: 25rpx;
}

.retry-button {
  min-width: 160rpx;
  min-height: 64rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 1rpx solid var(--color-brand);
  border-radius: 32rpx;
  background: var(--color-surface);
  color: var(--color-primary);
  font-size: 24rpx;
  line-height: 62rpx;
}

/* 拟真骨架屏（冷启动首帧与分模块加载共用） */
.sk-anim {
  animation: sk-pulse 1.4s ease-in-out infinite;
}

@keyframes sk-pulse {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.5;
  }
}

.sk-trend {
  display: flex;
  align-items: flex-end;
  gap: 24rpx;
  height: 240rpx;
  padding: 24rpx 8rpx 0;
}

.sk-trend-bar {
  flex: 1;
  border-radius: 8rpx;
  background-color: var(--color-divider);
}

.sk-pie-wrap {
  display: flex;
  align-items: center;
  gap: 40rpx;
  padding: 24rpx 8rpx;
}

.sk-pie {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background-color: var(--color-divider);
  flex-shrink: 0;
}

.sk-lines {
  flex: 1;
  min-width: 0;
}

.sk-line {
  height: 28rpx;
  border-radius: 8rpx;
  background-color: var(--color-divider);
  margin-bottom: 24rpx;
}

.sk-line:last-child {
  margin-bottom: 0;
}

.sk-line-short {
  width: 60%;
}
