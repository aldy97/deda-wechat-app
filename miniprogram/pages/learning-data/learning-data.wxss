.learning-data-page {
  padding-bottom: 48rpx;
}

.overview {
  display: flex;
  flex-wrap: wrap;
  padding: 32rpx 0;
}

.overview-item {
  width: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
  box-sizing: border-box;
}

.overview-value {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--primary-color);
}

.overview-label {
  font-size: 24rpx;
  margin-top: 8rpx;
}

.filter-bar {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 24rpx;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.record-item {
  padding: 24rpx;
}

.record-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.record-time {
  font-size: 24rpx;
}

.record-content {
  font-size: 28rpx;
  line-height: 1.6;
}

.no-more {
  display: block;
  text-align: center;
  padding: 32rpx 0;
}
