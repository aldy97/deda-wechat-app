<view class="container learning-data-page" bind:tap="onDismissUsageTooltip">
  <view class="report-heading">
    <view class="heading-copy">
      <text class="heading-title">成长报告</text>
    </view>
    <device-switch-dropdown
      devices="{{ deviceOptions }}"
      selected-id="{{ selectedDeviceId }}"
      selected-name="{{ selectedDeviceName }}"
      loading="{{ loadingDevices }}"
      bind:change="onDeviceChange"
    />
  </view>

  <block wx:if="{{ loadingDevices }}">
    <!-- 拟真骨架：与真实布局一致，冷启动首帧即完整页面轮廓 -->
    <view class="card report-section">
      <view class="section-heading">
        <view>
          <text class="section-title">每日使用时长</text>
          <text class="section-subtitle">近 7 日 · 单位：分钟</text>
        </view>
      </view>
      <view class="sk-trend sk-anim">
        <view
          class="sk-trend-bar"
          wx:for="{{ [72, 128, 76, 148, 96, 60, 120] }}"
          wx:key="*this"
          style="height: {{ item }}rpx;"
        ></view>
      </view>
    </view>
    <view class="card report-section">
      <view class="section-heading">
        <view>
          <text class="section-title">功能使用情况</text>
        </view>
      </view>
      <view class="sk-pie-wrap sk-anim">
        <view class="sk-pie"></view>
        <view class="sk-lines">
          <view class="sk-line"></view>
          <view class="sk-line"></view>
          <view class="sk-line sk-line-short"></view>
        </view>
      </view>
    </view>
    <view class="card report-section">
      <view class="section-heading">
        <view>
          <text class="section-title">当日使用总结</text>
          <text class="section-subtitle">从真实对话中整理的观察</text>
        </view>
      </view>
      <view class="sk-anim">
        <view class="sk-line"></view>
        <view class="sk-line"></view>
        <view class="sk-line"></view>
        <view class="sk-line sk-line-short"></view>
      </view>
    </view>
  </block>

  <view wx:elif="{{ deviceError }}" class="card empty-device">
    <text class="empty-device-title">设备加载失败</text>
    <text class="empty-device-copy">请检查网络后重新加载。</text>
    <button class="retry-button" bind:tap="onRetryDevices">重新加载</button>
  </view>

  <view wx:elif="{{ devices.length === 0 }}" class="card empty-device">
    <text class="empty-device-title">先绑定一台 Elly</text>
    <text class="empty-device-copy">绑定后，这里会自动生成每日家长报告。</text>
  </view>

  <block wx:else>
    <!-- 汇报一：每日使用时长 -->
    <view class="card report-section">
      <view class="section-heading">
        <view>
          <text class="section-title">每日使用时长</text>
          <text class="section-subtitle">近 7 日 · 单位：分钟</text>
        </view>
      </view>
      <view wx:if="{{ loadingDaily && trendBars.length === 0 }}" class="sk-trend sk-anim">
        <view
          class="sk-trend-bar"
          wx:for="{{ [72, 128, 76, 148, 96, 60, 120] }}"
          wx:key="*this"
          style="height: {{ item }}rpx;"
        ></view>
      </view>
      <view wx:elif="{{ dailyError && trendBars.length === 0 }}" class="section-error">
        <text>使用时长加载失败</text>
        <button class="retry-button" bind:tap="onRetryDaily">重试</button>
      </view>
      <view wx:elif="{{ trendBars.length > 0 }}" class="trend-chart">
        <view class="trend-item" wx:for="{{ trendBars }}" wx:key="label">
          <text class="trend-value">{{ item.value }}</text>
          <view class="trend-track">
            <view class="trend-bar {{ item.value === 0 ? 'trend-bar-empty' : '' }}" style="height: {{ item.height }}rpx;"></view>
          </view>
          <text class="trend-label">{{ item.label }}</text>
        </view>
      </view>
      <view wx:else class="empty-state">
        <view class="empty-chart-icon"><i></i><i></i><i></i></view>
        <text class="empty-tip">暂无使用时长记录</text>
      </view>
    </view>

    <!-- 汇报二：功能使用情况 -->
    <view class="card report-section">
      <view class="section-heading">
        <view>
          <view class="section-title-row">
            <text class="section-title">功能使用情况</text>
            <!-- <button class="usage-help" bind:tap="onUsageHelp" aria-label="了解功能使用统计">?</button> -->
          </view>
          <!-- 副标题不依赖 loadingUsage：缓存首帧/静默刷新期间保持显示，不再晚一秒出现 -->
          <text wx:if="{{ !usageError && usageActualDays > 0 }}" class="section-subtitle">近 {{ usageActualDays }} 天 · 功能互动占比</text>
        </view>
      </view>
      <view wx:if="{{ loadingUsage && modeUsage.length === 0 && !usagePieVisible }}" class="sk-pie-wrap sk-anim">
        <view class="sk-pie"></view>
        <view class="sk-lines">
          <view class="sk-line"></view>
          <view class="sk-line"></view>
          <view class="sk-line sk-line-short"></view>
        </view>
      </view>
      <view wx:elif="{{ usageError && modeUsage.length === 0 && !usagePieVisible }}" class="section-error">
        <text>功能使用数据加载失败</text>
        <button class="retry-button" bind:tap="onRetryUsage">重试</button>
      </view>
      <block wx:elif="{{ modeUsage.length > 0 || usagePieVisible }}">
        <view class="usage-chart" wx:if="{{ usagePieVisible }}">
          <canvas
            id="usagePieCanvas"
            class="usage-pie"
            type="2d"
            bind:tap="onUsagePieTap"
            aria-label="功能使用比例扇形图，点击查看模式占比"
          ></canvas>
        </view>
        <view class="usage-list" wx:if="{{ modeUsage.length > 0 }}">
          <view class="usage-row" wx:for="{{ modeUsage }}" wx:key="mode">
            <view class="usage-name-wrap">
              <view class="usage-dot" style="background-color: {{ item.color }};"></view>
              <text class="usage-name">{{ item.label }}</text>
            </view>
            <view class="usage-numbers">
              <text class="usage-percent">{{ item.percent }}%</text>
              <text class="usage-count">{{ item.count }} 次</text>
            </view>
          </view>
        </view>
      </block>
      <view wx:else class="empty-state">
        <view class="empty-report-icon"></view>
        <text class="empty-tip">暂无功能使用记录</text>
      </view>
    </view>

    <!-- 汇报三：当日使用总结 -->
    <view class="card report-section summary-section">
      <view class="section-heading">
        <view>
          <text class="section-title">当日使用总结</text>
          <text class="section-subtitle">从真实对话中整理的观察</text>
        </view>
      </view>
      <view wx:if="{{ loadingReport }}" class="sk-anim">
        <view class="sk-line"></view>
        <view class="sk-line"></view>
        <view class="sk-line"></view>
        <view class="sk-line"></view>
        <view class="sk-line sk-line-short"></view>
      </view>
      <view wx:elif="{{ reportError }}" class="section-error">
        <text>当日总结加载失败</text>
        <button class="retry-button" bind:tap="onRetryReport">重试</button>
      </view>
      <block wx:elif="{{ hasSummaryContent }}">
        <view wx:if="{{ summary.expressionObservation }}" class="observation-row">
          <text class="observation-index">01</text>
          <view class="observation-content">
            <text class="observation-title">表达观察</text>
            <text class="observation-text">{{ summary.expressionObservation }}</text>
          </view>
        </view>
        <view wx:if="{{ summary.emotionObservation }}" class="observation-row">
          <text class="observation-index">02</text>
          <view class="observation-content">
            <text class="observation-title">情绪观察</text>
            <text class="observation-text">{{ summary.emotionObservation }}</text>
          </view>
        </view>
        <view wx:if="{{ summary.thinkingObservation }}" class="observation-row">
          <text class="observation-index">03</text>
          <view class="observation-content">
            <text class="observation-title">思考观察</text>
            <text class="observation-text">{{ summary.thinkingObservation }}</text>
          </view>
        </view>
        <view wx:if="{{ summary.suggestion }}" class="suggestion-box">
          <text class="suggestion-title">给家长的小建议</text>
          <text class="suggestion-text">{{ summary.suggestion }}</text>
        </view>
        <view class="feedback-block">
          <text wx:if="{{ feedback }}" class="feedback-thanks">感谢你的反馈</text>
          <block wx:else>
            <text class="feedback-question">这份报告对你有帮助吗？</text>
            <view class="feedback-actions">
              <button
                class="feedback-button"
                data-useful="{{ true }}"
                disabled="{{ feedbackSubmitting }}"
                bind:tap="onFeedback"
              >有用</button>
              <button
                class="feedback-button"
                data-useful="{{ false }}"
                disabled="{{ feedbackSubmitting }}"
                bind:tap="onFeedback"
              >没用</button>
            </view>
          </block>
        </view>
      </block>
      <view wx:else class="summary-empty">
        <view class="pending-icon {{ hasReportActivity ? '' : 'pending-icon-quiet' }}"></view>
        <text class="summary-empty-title">报告还在准备中</text>
        <text class="summary-empty-copy">{{ hasReportActivity ? '有足够对话内容后，这里会自动生成观察与建议。' : '昨日没有对话内容，不会生成观察与建议。' }}</text>
      </view>
      <text wx:if="{{ !loadingReport && !reportError }}" class="ai-disclaimer">部分内容由 AI 根据对话生成，请结合实际情况理解。</text>
    </view>
  </block>
</view>
