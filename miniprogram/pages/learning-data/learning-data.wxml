<view class="container learning-data-page">
  <!-- 时间范围切换 -->
  <van-tabs active="{{ activeRange }}" bind:change="onRangeChange" custom-class="range-tabs">
    <van-tab name="today" title="今日"></van-tab>
    <van-tab name="week" title="本周"></van-tab>
    <van-tab name="month" title="本月"></van-tab>
  </van-tabs>

  <!-- 家庭总览卡 -->
  <view class="overview card">
    <block wx:if="{{ loading.summary }}">
      <view class="overview-item" wx:for="{{ [1,2,3,4] }}" wx:key="*this">
        <van-skeleton row="1" row-width="60rpx" title="{{ false }}" />
        <van-skeleton row="1" row-width="80rpx" title="{{ false }}" />
      </view>
    </block>
    <block wx:else>
      <view class="overview-item">
        <text class="overview-value">{{ dashboard.totalDurationMinutes || 0 }}</text>
        <text class="overview-label text-secondary">总时长(分)</text>
      </view>
      <view class="overview-item">
        <text class="overview-value">{{ dashboard.totalSessions || 0 }}</text>
        <text class="overview-label text-secondary">总练习</text>
      </view>
      <view class="overview-item">
        <text class="overview-value">{{ dashboard.activeDeviceCount || 0 }}</text>
        <text class="overview-label text-secondary">活跃设备</text>
      </view>
      <view class="overview-item">
        <text class="overview-value">{{ dashboard.maxContinuousDays || dashboard.continuousDays || 0 }}</text>
        <text class="overview-label text-secondary">最长连续天</text>
      </view>
    </block>
  </view>

