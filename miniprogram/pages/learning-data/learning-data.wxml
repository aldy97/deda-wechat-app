<view class="container learning-data-page">
  <!-- 时间范围切换 -->
  <van-tabs active="{{ activeRange }}" bind:change="onRangeChange" custom-class="range-tabs">
    <van-tab name="today" title="今日"></van-tab>
    <van-tab name="week" title="本周"></van-tab>
    <van-tab name="month" title="本月"></van-tab>
  </van-tabs>

  <!-- 家庭总览卡 -->
  <view class="overview card">
    <block wx:if="{{ loading.summary }}">
      <view class="overview-item" wx:for="{{ [1,2,3,4] }}" wx:key="*this">
        <van-skeleton row="1" row-width="60rpx" title="{{ false }}" />
        <van-skeleton row="1" row-width="80rpx" title="{{ false }}" />
      </view>
    </block>
    <block wx:else>
      <view class="overview-item">
        <text class="overview-value">{{ dashboard.totalDurationMinutes || 0 }}</text>
        <text class="overview-label text-secondary">总时长(分)</text>
      </view>
      <view class="overview-item">
        <text class="overview-value">{{ dashboard.totalSessions || 0 }}</text>
        <text class="overview-label text-secondary">总练习</text>
      </view>
      <view class="overview-item">
        <text class="overview-value">{{ dashboard.activeDeviceCount || 0 }}</text>
        <text class="overview-label text-secondary">活跃设备</text>
      </view>
      <view class="overview-item">
        <text class="overview-value">{{ dashboard.continuousDays || 0 }}</text>
        <text class="overview-label text-secondary">连续天</text>
      </view>
    </block>
  </view>

  <!-- AI 学习洞察 -->
  <view class="section card insights-section">
    <view class="section-title-row">
      <text class="section-title">智能洞察</text>
      <text class="section-subtitle text-secondary">AI 分析</text>
    </view>
    <view class="insights-skeleton" wx:if="{{ loading.insights }}">
      <van-skeleton row="3" title="{{ false }}" />
    </view>
    <view class="insights-list" wx:elif="{{ insights.length > 0 }}">
      <view
        class="insight-item insight-{{ item.type }}"
        wx:for="{{ insights }}"
        wx:key="id"
      >
        <van-icon
          class="insight-icon"
          name="{{ item.type === 'alert' ? 'warning-o' : item.type === 'weakness' ? 'info-o' : item.type === 'milestone' ? 'fire-o' : 'success' }}"
          size="36rpx"
        />
        <view class="insight-content">
          <text class="insight-title">{{ item.title }}</text>
          <text class="insight-text">{{ item.content }}</text>
        </view>
      </view>
    </view>
    <text wx:else class="empty-tip text-secondary">暂无洞察</text>
  </view>

  <!-- 学习健康度 -->
  <view class="section card health-section">
    <view class="section-title-row">
      <text class="section-title">学习健康度</text>
      <text class="health-level health-level-{{ health.level || 'attention' }}">{{ health.score || 0 }}分</text>
    </view>
    <view class="health-skeleton" wx:if="{{ loading.health }}">
      <van-skeleton row="2" title="{{ false }}" />
    </view>
    <block wx:elif="{{ health.score != null }}">
      <view class="health-score-wrap">
        <view class="health-ring">
          <text class="health-score">{{ health.score }}</text>
          <text class="health-score-label">综合评分</text>
        </view>
        <text class="health-suggestion">{{ health.suggestion }}</text>
      </view>
      <view class="health-dimensions">
        <view class="health-dimension" wx:for="{{ [{key:'activity',label:'活跃度'},{key:'consistency',label:'坚持度'},{key:'balance',label:'均衡度'},{key:'engagement',label:'互动深度'}] }}" wx:key="key">
          <text class="dimension-label text-secondary">{{ item.label }}</text>
          <van-progress
            percentage="{{ health.dimensions[item.key] || 0 }}"
            stroke-height="8"
            color="{{ health.level === 'attention' ? '#ff976a' : health.level === 'excellent' ? '#07c160' : '#1989fa' }}"
            show-pivot="{{ false }}"
          />
        </view>
      </view>
    </block>
    <text wx:else class="empty-tip text-secondary">暂无健康度数据</text>
  </view>

  <!-- 学习趋势 -->
  <view class="section card">
    <view class="section-title-row">
      <text class="section-title">学习趋势</text>
      <text class="trend-caption text-secondary">单位:分钟</text>
    </view>
    <view class="trend-skeleton" wx:if="{{ loading.trend }}">
      <van-skeleton row="1" row-width="100%" title="{{ false }}" />
    </view>
    <view class="trend-chart" wx:elif="{{ trendBars.length > 0 }}">
      <view class="trend-bar-wrap" wx:for="{{ trendBars }}" wx:key="label">
        <text class="trend-value" wx:if="{{ item.value > 0 }}">{{ item.value }}</text>
        <view class="trend-bar" style="height: {{ item.height }}rpx;"></view>
        <text class="trend-date">{{ item.label }}</text>
      </view>
    </view>
    <text wx:else class="empty-tip text-secondary">暂无趋势数据</text>
  </view>

  <!-- 主题分布 -->
  <view class="section card">
    <text class="section-title">主题分布</text>
    <view class="topic-skeleton" wx:if="{{ loading.topics }}">
      <van-skeleton row="4" title="{{ false }}" />
    </view>
    <view class="topic-list" wx:elif="{{ topics.length > 0 }}">
      <view class="topic-item" wx:for="{{ topics }}" wx:key="id">
        <view class="topic-main">
          <text class="topic-name {{ item.isActive ? 'topic-active' : '' }}">
            {{ item.conversationModeName || item.textbookName || item.mode }}
            <text wx:if="{{ item.unitName }}"> · {{ item.unitName }}</text>
          </text>
          <van-tag wx:if="{{ item.isActive }}" type="success" size="medium">当前</van-tag>
        </view>
        <view class="topic-meta">
          <text class="topic-score text-secondary">{{ item.avgScore != null ? item.avgScore + '分' : '--' }}</text>
          <text class="topic-count text-secondary">{{ item.count }} 次对话</text>
        </view>
      </view>
    </view>
    <text wx:else class="empty-tip text-secondary">暂无主题数据</text>
  </view>

  <!-- 孩子设备 -->
  <view class="section-title section-title-with-margin">孩子设备</view>
  <view class="device-skeleton card" wx:if="{{ loading.devices }}">
    <van-skeleton row="3" title="{{ false }}" />
  </view>
  <block wx:elif="{{ dashboard.devices }}">
    <view
      class="device-summary-card card"
      wx:for="{{ dashboard.devices }}"
      wx:key="deviceId"
      data-device-id="{{ item.deviceId }}"
      bind:tap="onDeviceCardTap"
    >
      <view class="summary-header">
        <view class="summary-left">
          <text class="summary-child">{{ item.childName || '未命名' }}</text>
          <text class="summary-device text-secondary">{{ item.deviceName }}</text>
        </view>
        <van-tag type="{{ item.status === 'online' ? 'success' : item.status === 'sleeping' ? 'warning' : 'danger' }}">
          {{ item.status === 'online' ? '在线' : item.status === 'sleeping' ? '休眠' : '离线' }}
        </van-tag>
      </view>
      <view class="summary-metrics">
        <view class="summary-metric">
          <text class="summary-value">{{ item.todayDurationMinutes || 0 }}</text>
          <text class="summary-label text-secondary">今日(分)</text>
        </view>
        <view class="summary-metric">
          <text class="summary-value">{{ item.weekDurationMinutes || 0 }}</text>
          <text class="summary-label text-secondary">本周(分)</text>
        </view>
        <view class="summary-metric">
          <text class="summary-value">{{ item.continuousDays || 0 }}</text>
          <text class="summary-label text-secondary">连续天</text>
        </view>
        <view class="summary-metric">
          <text class="summary-value">{{ item.topicCount || 0 }}</text>
          <text class="summary-label text-secondary">主题数</text>
        </view>
      </view>
      <view class="summary-action">
        <text class="action-text text-secondary">查看智能分析</text>
        <van-icon name="arrow" size="24rpx" color="#999999" />
      </view>
    </view>
  </block>

  <!-- 学习动态 -->
  <view class="section-title section-title-with-margin">学习动态</view>
  <view class="timeline-skeleton card" wx:if="{{ loading.timeline }}">
    <van-skeleton row="4" title="{{ false }}" />
  </view>
  <view class="timeline-list" wx:elif="{{ timeline.length > 0 }}">
    <view class="timeline-item card" wx:for="{{ timeline }}" wx:key="id">
      <view class="timeline-dot"></view>
      <view class="timeline-content">
        <view class="timeline-header">
          <text class="timeline-topic">{{ item.topicName }}</text>
          <text class="timeline-device text-secondary">{{ item.deviceName }}</text>
        </view>
        <text class="timeline-text">{{ item.userText }}</text>
        <text class="timeline-ai">{{ item.aiText }}</text>
        <text class="timeline-time text-secondary">{{ item.displayTime }}</text>
      </view>
    </view>
  </view>
  <text wx:else class="empty-tip text-secondary">暂无学习动态</text>

  <van-button
    wx:if="{{ hasMore }}"
    type="default"
    block
    loading="{{ loading.timeline }}"
    bind:click="onLoadMore"
  >
    加载更多
  </van-button>
  <text wx:elif="{{ timeline.length > 0 }}" class="no-more text-secondary">没有更多了</text>
</view>
