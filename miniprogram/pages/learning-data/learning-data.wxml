  -->

  <!-- 主题分布 -->
  <view class="section card">
    <text class="section-title">主题分布</text>
    <view class="topic-skeleton" wx:if="{{ loading.topics }}">
      <van-skeleton row="4" title="{{ false }}" />
    </view>
    <view class="topic-list" wx:elif="{{ topics.length > 0 }}">
      <view class="topic-item" wx:for="{{ topics }}" wx:key="id">
        <view class="topic-main">
          <view class="topic-name-wrap {{ item.isActive ? 'topic-active' : '' }}">
            <text class="topic-name">
              {{ item.conversationModeName || item.textbookName || item.mode }}
              <text wx:if="{{ item.unitName }}"> · {{ item.unitName }}</text>
            </text>
          </view>
          <view wx:if="{{ item.isActive }}" class="topic-current-tag">学习中</view>
        </view>
        <view class="topic-meta">
          <text class="topic-score text-secondary">{{ item.avgScore != null ? item.avgScore + '分' : '--' }}</text>
          <text class="topic-count text-secondary">{{ item.count }} 次对话</text>
        </view>
      </view>
    </view>
    <text wx:else class="empty-tip text-secondary">暂无主题数据</text>
  </view>

  <!-- 孩子设备 -->
  <view class="section-title section-title-with-margin">孩子设备</view>
  <view class="device-skeleton card" wx:if="{{ loading.devices }}">
    <van-skeleton row="3" title="{{ false }}" />
  </view>
  <block wx:elif="{{ dashboard.devices }}">
    <view
      class="device-summary-card card"
      wx:for="{{ dashboard.devices }}"
      wx:key="deviceId"
      data-device-id="{{ item.deviceId }}"
      bind:tap="onDeviceCardTap"
    >
      <view class="summary-header">
        <view class="summary-left">
          <view class="summary-child-row">
            <text class="summary-child-cn">{{ item.childName || item.deviceName }}</text>
            <text class="summary-child-en" wx:if="{{ item.childEnglishName }}">{{ item.childEnglishName }}</text>
          </view>
          <text class="summary-device text-secondary">{{ item.deviceName }}</text>
        </view>
        <van-tag type="{{ item.status === 'online' ? 'success' : item.status === 'sleeping' ? 'warning' : 'danger' }}">
          {{ item.status === 'online' ? '在线' : item.status === 'sleeping' ? '休眠' : '离线' }}
        </van-tag>
      </view>
      <view class="summary-metrics">
        <view class="summary-metric">
          <text class="summary-value">{{ item.todayDurationMinutes || 0 }}</text>
          <text class="summary-label text-secondary">今日(分)</text>
        </view>
        <view class="summary-metric">
          <text class="summary-value">{{ item.weekDurationMinutes || 0 }}</text>
          <text class="summary-label text-secondary">本周(分)</text>
        </view>
        <view class="summary-metric">
          <text class="summary-value">{{ item.continuousDays || 0 }}</text>
          <text class="summary-label text-secondary">连续天</text>
        </view>
        <view class="summary-metric">
          <text class="summary-value">{{ item.topicCount || 0 }}</text>
          <text class="summary-label text-secondary">主题数</text>
        </view>
      </view>
      <view class="summary-action">
        <text class="action-text text-secondary">查看智能分析</text>
        <van-icon name="arrow" size="24rpx" color="#999999" />
      </view>
    </view>
  </block>

  <!-- 学习动态 -->
  <view class="section-title-row section-title-with-margin">
    <text class="section-title">学习动态</text>
    <text class="section-subtitle text-secondary">共 {{ dashboard.boundDeviceCount || 0 }} 台设备</text>
  </view>
  <view class="timeline-skeleton card" wx:if="{{ loading.timeline }}">
    <van-skeleton row="4" title="{{ false }}" />
  </view>
  <view class="timeline-days" wx:elif="{{ timeline.length > 0 }}">
    <view class="timeline-day" wx:for="{{ timeline }}" wx:key="date" wx:for-item="day">
      <text class="timeline-day-label">{{ day.displayDate }}</text>
      <view class="timeline-device-groups">
        <view class="timeline-device-group card" wx:for="{{ day.devices }}" wx:key="deviceId" wx:for-item="device">
          <view
            class="timeline-device-header"
            data-date="{{ day.date }}"
            data-device-id="{{ device.deviceId }}"
            bind:tap="onToggleDeviceGroup"
          >
            <view class="timeline-device-info">
              <view class="timeline-device-avatar">
                <van-icon name="chat-o" size="32rpx" color="#4a90d9" />
              </view>
              <view class="timeline-device-names">
                <text class="timeline-device-name">{{ device.deviceName }}</text>
                <text class="timeline-device-duration text-secondary">{{ device.totalDurationMinutes }} 分钟 · {{ device.events.length }} 轮对话</text>
              </view>
            </view>
            <van-icon
              name="arrow-down"
              size="28rpx"
              color="#999999"
              class="timeline-device-arrow {{ device.expanded ? 'expanded' : '' }}"
            />
          </view>
          <view class="timeline-device-events {{ device.expanded ? 'expanded' : '' }}">
            <view class="timeline-event" wx:for="{{ device.events }}" wx:key="id" wx:for-item="event">
              <view class="timeline-event-header">
                <text class="timeline-event-topic">{{ event.topicName }}</text>
                <text class="timeline-event-time text-secondary">{{ event.displayTime }}</text>
              </view>
              <text class="timeline-event-text">{{ event.userText }}</text>
              <text class="timeline-event-ai">{{ event.aiText }}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
  <text wx:else class="empty-tip text-secondary">暂无学习动态</text>

  <load-more
    wx:if="{{ timeline.length > 0 || loading.timeline }}"
    loading="{{ loading.timeline }}"
    has-more="{{ hasMore }}"
    bind:loadmore="onLoadMore"
  />
</view>
