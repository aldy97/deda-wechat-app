<view class="container learning-data-page">
  <!-- 加载中 -->
  <view class="loading-wrap" wx:if="{{ loading && !overview.devices }}">
    <van-loading type="spinner" size="48rpx">加载中...</van-loading>
  </view>

  <block wx:elif="{{ overview.devices }}">
    <!-- 家庭总览卡 -->
    <view class="overview card">
      <view class="overview-item">
        <text class="overview-value">{{ overview.totalDuration || 0 }}</text>
        <text class="overview-label text-secondary">本周时长(分)</text>
      </view>
      <view class="overview-item">
        <text class="overview-value">{{ overview.totalSessions || 0 }}</text>
        <text class="overview-label text-secondary">本周练习</text>
      </view>
      <view class="overview-item">
        <text class="overview-value">{{ overview.activeDeviceCount || 0 }}</text>
        <text class="overview-label text-secondary">在线设备</text>
      </view>
      <view class="overview-item">
        <text class="overview-value">{{ overview.devices.length || 0 }}</text>
        <text class="overview-label text-secondary">绑定设备</text>
      </view>
    </view>

    <!-- 家庭学习趋势 -->
    <view class="section card">
      <text class="section-title">近7天家庭学习趋势</text>
      <view class="trend-chart">
        <view
          class="trend-bar-wrap"
          wx:for="{{ trend }}"
          wx:key="date"
        >
          <view class="trend-bar" style="height: {{ item.duration > 0 ? Math.min(item.duration, 120) / 120 * 160 : 4 }}rpx;"></view>
          <text class="trend-date">{{ item.date }}</text>
        </view>
      </view>
    </view>

    <!-- 分设备汇总卡 -->
    <view class="section-title">孩子设备</view>
    <view
      class="device-summary-card card"
      wx:for="{{ overview.devices }}"
      wx:key="deviceId"
      data-device-id="{{ item.deviceId }}"
      bind:tap="onDeviceCardTap"
    >
      <view class="summary-header">
        <view class="summary-left">
          <text class="summary-child">{{ item.childName }}</text>
          <text class="summary-device text-secondary">{{ item.deviceName }}</text>
        </view>
        <van-tag type="{{ item.status === 'online' ? 'success' : item.status === 'sleeping' ? 'warning' : 'danger' }}">
          {{ item.status === 'online' ? '在线' : item.status === 'sleeping' ? '休眠' : '离线' }}
        </van-tag>
      </view>
      <view class="summary-metrics">
        <view class="summary-metric">
          <text class="summary-value">{{ item.todayDuration }}</text>
          <text class="summary-label text-secondary">今日(分)</text>
        </view>
        <view class="summary-metric">
          <text class="summary-value">{{ item.weekDuration }}</text>
          <text class="summary-label text-secondary">本周(分)</text>
        </view>
        <view class="summary-metric">
          <text class="summary-value">{{ item.continuousDays }}</text>
          <text class="summary-label text-secondary">连续天</text>
        </view>
        <view class="summary-metric">
          <text class="summary-value">{{ item.avgScore }}</text>
          <text class="summary-label text-secondary">均分</text>
        </view>
      </view>
    </view>

    <!-- 动态时间线 -->
    <view class="section-title">学习动态</view>
    <view class="timeline-list">
      <view
        class="timeline-item card"
        wx:for="{{ timeline }}"
        wx:key="id"
      >
        <view class="timeline-dot"></view>
        <view class="timeline-content">
          <text class="timeline-text">{{ item.content }}</text>
          <text class="timeline-time text-secondary">{{ item.createdAt }}</text>
        </view>
      </view>
    </view>

    <van-button
      wx:if="{{ hasMore }}"
      type="default"
      block
      loading="{{ loading }}"
      bind:click="onLoadMore"
    >
      加载更多
    </van-button>
    <text wx:elif="{{ timeline.length > 0 }}" class="no-more text-secondary">没有更多了</text>
  </block>
</view>
