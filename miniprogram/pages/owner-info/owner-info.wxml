<view class="container owner-info-page">
  <!-- 加载中 -->
  <view class="loading-wrap" wx:if="{{ loading }}">
    <van-loading type="spinner" size="48rpx">加载中...</van-loading>
  </view>

  <!-- 编辑表单 -->
  <view wx:else>
    <!-- 绑定成功引导横幅（仅 from=bind 进入时展示） -->
    <view class="bind-guide-banner" wx:if="{{ fromBind }}">
      <van-icon name="checked" size="36rpx" color="var(--color-success)" />
      <view class="bind-guide-text">
        <text class="bind-guide-title">绑定成功！</text>
        <text class="bind-guide-subtitle">完善孩子信息，让 Elly 更懂 TA</text>
      </view>
    </view>

    <van-cell-group inset class="form-group">
      <van-field
        label="名字"
        placeholder="请输入孩子名字"
        value="{{ form.name }}"
        bind:change="onNameChange"
        maxlength="20"
        input-align="right"
      />
      <van-field
        label="英文名"
        placeholder="请输入孩子英文名（AI 称呼用）"
        value="{{ form.englishName }}"
        bind:change="onEnglishNameChange"
        maxlength="50"
        input-align="right"
      />
      <van-cell
        title="性别"
        value="{{ form.gender === 'male' ? '小王子' : (form.gender === 'female' ? '小公主' : '请选择') }}"
        value-class="{{ form.gender ? 'cell-value-dark' : '' }}"
        is-link
        bind:click="onOpenGenderPicker"
      />
      <van-cell
        title="生日"
        value="{{ form.birthday || '请选择生日' }}"
        value-class="{{ form.birthday ? 'cell-value-dark' : '' }}"
        is-link
        bind:click="onOpenDatePicker"
      />
    </van-cell-group>

    <!-- 保存按钮 -->
    <view class="save-btn-wrap">
      <van-button
        type="primary"
        block
        disabled="{{ saving }}"
        bind:click="onSave"
      >
        保存
      </van-button>
      <!-- 绑定引导链路允许跳过 -->
      <view
        wx:if="{{ fromBind }}"
        class="skip-bind-guide"
        bind:tap="onSkipBindGuide"
        aria-role="button"
        aria-label="稍后再填"
      >稍后再填</view>
    </view>
  </view>

  <!-- 保存中遮罩 -->
  <view class="save-overlay" wx:if="{{ saving }}">
    <van-loading type="spinner" size="48rpx">保存中…</van-loading>
  </view>

  <!-- 日期选择弹窗 -->
  <van-popup
    show="{{ showDatePicker }}"
    position="bottom"
    bind:close="onCloseDatePicker"
  >
    <van-datetime-picker
      type="date"
      value="{{ currentDate }}"
      bind:confirm="onDateConfirm"
      bind:cancel="onCloseDatePicker"
      bind:input="onDateChange"
      min-date="{{ 0 }}"
      max-date="{{ 1704067200000 }}"
    />
  </van-popup>

  <!-- 性别选择弹窗 -->
  <van-popup
    show="{{ showGenderPicker }}"
    position="bottom"
    round
    bind:close="onCancelGender"
  >
    <view class="gender-picker">
      <view
        class="gender-option {{ tempGender === 'male' ? 'active' : '' }}"
        data-value="male"
        bind:tap="onGenderOptionTap"
      >小王子</view>
      <view
        class="gender-option {{ tempGender === 'female' ? 'active' : '' }}"
        data-value="female"
        bind:tap="onGenderOptionTap"
      >小公主</view>
      <view class="gender-actions">
        <van-button
          custom-class="gender-btn gender-btn-cancel"
          bind:click="onCancelGender"
        >取消</van-button>
        <van-button
          type="primary"
          custom-class="gender-btn"
          bind:click="onConfirmGender"
        >确定</van-button>
      </view>
    </view>
  </van-popup>
</view>
