<kid-gradient-bg>
  <view class="kid-page" style="padding-top: {{ statusBarHeight }}px;">
    <view class="kid-nav" style="height: {{ navBarHeight }}px;">
      <view
        class="kid-back"
        bind:tap="onBack"
        hover-class="kid-back-hover"
        aria-role="button"
        aria-label="返回"
      >
        <van-icon name="arrow-left" size="44rpx" color="var(--color-title)" />
      </view>
    </view>

    <view wx:if="{{ loading }}" class="kid-state">
      <van-loading type="spinner" size="48rpx" color="var(--color-kid-accent)">加载中...</van-loading>
    </view>

    <view wx:elif="{{ loadError }}" class="kid-state kid-state-error">
      <text class="kid-state-text">孩子信息加载失败，请稍后重试</text>
      <view
        class="kid-retry"
        bind:tap="onRetryLoad"
        aria-role="button"
        aria-label="重新加载"
      >重新加载</view>
    </view>

    <block wx:else>
      <view class="kid-paws">
        <block wx:for="{{ pawItems }}" wx:key="*this">
          <view wx:if="{{ index > 0 }}" class="kid-paw-line"></view>
          <view class="kid-paw">
            <view class="kid-paw-toe kid-paw-toe-1"></view>
            <view class="kid-paw-toe kid-paw-toe-2"></view>
            <view class="kid-paw-toe kid-paw-toe-3"></view>
            <view class="kid-paw-pad"></view>
          </view>
        </block>
      </view>

      <!-- 页头「Elly + 对话气泡」：仅在绑定引导流程展示，日常设置不提示 -->
      <view class="kid-hero" wx:if="{{ fromBind }}">
        <elly-bubble lines="{{ bubbleLines }}" />
      </view>

      <view class="kid-genders">
        <view
          class="kid-gender {{ form.gender === 'male' ? 'kid-gender-active' : '' }}"
          data-gender="male"
          bind:tap="onSelectGender"
          aria-role="button"
          aria-label="选择小王子"
        >
          <view class="kid-gender-art">
            <image
              class="kid-gender-img"
              src="/static/images/kid-info/avatar_boy.png"
              mode="aspectFill"
            />
          </view>
          <text class="kid-gender-label">小王子</text>
        </view>

        <view
          class="kid-gender {{ form.gender === 'female' ? 'kid-gender-active' : '' }}"
          data-gender="female"
          bind:tap="onSelectGender"
          aria-role="button"
          aria-label="选择小公主"
        >
          <view class="kid-gender-art">
            <image
              class="kid-gender-img"
              src="/static/images/kid-info/avatar_girl.png"
              mode="aspectFill"
            />
          </view>
          <text class="kid-gender-label">小公主</text>
        </view>
      </view>

      <view class="kid-hint">
        <view class="kid-hint-icon"><van-icon name="question-o" size="26rpx" color="var(--color-kid-hint)" /></view>
        <text class="kid-hint-text">孩子性别影响推荐内容，别填错了哦</text>
      </view>

      <view class="kid-rows">
        <view class="kid-row">
          <text class="kid-row-label">昵称</text>
          <input
            class="kid-row-input"
            value="{{ form.name }}"
            maxlength="20"
            placeholder="请输入昵称"
            placeholder-class="kid-placeholder"
            adjust-position="{{ true }}"
            cursor-spacing="24"
            bindinput="onNameChange"
          />
        </view>

        <view class="kid-row">
          <text class="kid-row-label">英文名</text>
          <input
            class="kid-row-input"
            value="{{ form.englishName }}"
            maxlength="50"
            placeholder="AI 称呼用（选填）"
            placeholder-class="kid-placeholder"
            adjust-position="{{ true }}"
            cursor-spacing="24"
            bindinput="onEnglishNameChange"
          />
        </view>

        <view
          class="kid-row"
          bind:tap="onOpenDatePicker"
          aria-role="button"
          aria-label="选择生日"
        >
          <text class="kid-row-label">生日</text>
          <view class="kid-row-value">
            <text
              class="kid-row-text {{ form.birthday ? '' : 'kid-row-text-placeholder' }}"
            >{{ form.birthday || '请选择生日' }}</text>
            <van-icon name="arrow" size="30rpx" color="var(--color-kid-arrow)" />
          </view>
        </view>
      </view>

      <view class="kid-hint kid-hint-birthday">
        <view class="kid-hint-icon"><van-icon name="info-o" size="26rpx" color="var(--color-kid-hint)" /></view>
        <text class="kid-hint-text">信息仅用于DEDA听风原野小居民与孩子的对话，我们将严格保护孩子隐私。</text>
      </view>

      <view class="kid-cta-wrap">
        <view
          class="kid-cta {{ saving ? 'kid-cta-busy' : '' }}"
          bind:tap="onSave"
          hover-class="kid-cta-hover"
          aria-role="button"
          aria-label="保存孩子信息"
        >
          <van-loading
            wx:if="{{ saving }}"
            type="spinner"
            size="40rpx"
            color="var(--color-surface)"
          />
          <view wx:else class="kid-cta-arrow"></view>
        </view>
      </view>
    </block>

    <van-popup
      show="{{ showDatePicker }}"
      position="bottom"
      bind:close="onCloseDatePicker"
    >
      <van-datetime-picker
        type="date"
        value="{{ currentDate }}"
        min-date="{{ 0 }}"
        max-date="{{ maxBirthday }}"
        bind:confirm="onDateConfirm"
        bind:cancel="onCloseDatePicker"
        bind:input="onDateChange"
      />
    </van-popup>
  </view>
</kid-gradient-bg>
