.owner-info-page {
  min-height: 100vh;
  background-color: #f5f6f8;
  padding-top: 24rpx;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

.form-group {
  margin: 0 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.save-btn-wrap {
  margin: 48rpx 24rpx 0;
}

.save-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(255, 255, 255, 0.8);
  z-index: 100;
}
