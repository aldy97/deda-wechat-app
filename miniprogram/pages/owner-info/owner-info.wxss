.owner-info-page {
  min-height: 100vh;
  background-color: var(--color-bg);
  padding-top: 24rpx;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

.form-group {
  margin: 0 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

/* cell 右值与输入框文字保持一致的深色 */
.cell-value-dark {
  color: var(--color-text);
}

.save-btn-wrap {
  margin: 48rpx 24rpx 0;
}

/* 性别选择弹窗 */
.gender-picker {
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.gender-option {
  text-align: center;
  font-size: 32rpx;
  color: var(--color-secondary);
  padding: 32rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}

.gender-option.active {
  color: var(--color-text);
  font-weight: 500;
}

.gender-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 48rpx;
}

.gender-btn {
  flex: 1;
}

.gender-btn-cancel {
  background-color: var(--color-bg);
  color: var(--color-success);
  border: none;
}

.save-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--color-overlay-light);
  z-index: 100;
}
