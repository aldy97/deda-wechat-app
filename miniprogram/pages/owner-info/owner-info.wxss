page {
  background-color: var(--color-kid-bg-bottom);
}

.kid-page {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  min-height: 100vh;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

/* 自定义导航栏 */
.kid-nav {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}

.kid-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
}

.kid-back-hover {
  background-color: var(--color-kid-bubble);
}

/* 加载 / 错误态 */
.kid-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 48rpx;
  color: var(--color-body);
  font-size: 28rpx;
}

.kid-state-text {
  text-align: center;
}

.kid-retry {
  margin-top: 28rpx;
  padding: 18rpx 48rpx;
  border-radius: 999rpx;
  background-color: var(--color-surface);
  box-shadow: 0 8rpx 24rpx var(--color-kid-shadow);
  color: var(--color-kid-accent);
  font-size: 28rpx;
}

/* 页头「Elly + 对话气泡」容器：视觉实现收在 components/elly-bubble */
.kid-hero {
  padding: 12rpx 40rpx 0;
}

/* 爪印分隔 */
.kid-paws {
  display: flex;
  align-items: center;
  margin: 32rpx 0 24rpx;
  padding: 0 44rpx;
}

.kid-paw {
  position: relative;
  flex-shrink: 0;
  width: 40rpx;
  height: 34rpx;
}

.kid-paw-line {
  flex: 1;
  height: 2rpx;
  margin: 0 14rpx;
  background-color: var(--color-kid-paw);
}

.kid-paw-pad {
  position: absolute;
  left: 8rpx;
  bottom: 0;
  width: 24rpx;
  height: 18rpx;
  border-radius: 50% 50% 45% 45%;
  background-color: var(--color-kid-paw);
}

.kid-paw-toe {
  position: absolute;
  width: 9rpx;
  height: 11rpx;
  border-radius: 50%;
  background-color: var(--color-kid-paw);
}

.kid-paw-toe-1 {
  left: 0;
  top: 10rpx;
}

.kid-paw-toe-2 {
  left: 12rpx;
  top: 2rpx;
}

.kid-paw-toe-3 {
  left: 25rpx;
  top: 8rpx;
}

/* 性别卡片 */
.kid-genders {
  display: flex;
  justify-content: center;
  gap: 64rpx;
  margin-top: 40rpx;
}

.kid-gender {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 200rpx;
}

.kid-gender-art {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 200rpx;
  height: 200rpx;
  overflow: hidden;
  border: 6rpx solid transparent;
  border-radius: 32rpx;
  background-color: var(--color-surface);
  box-shadow: 0 10rpx 28rpx var(--color-kid-shadow);
}

.kid-gender-active .kid-gender-art {
  border-color: var(--color-kid-accent);
}

.kid-gender-img {
  width: 100%;
  height: 100%;
}

.kid-gender-label {
  margin-top: 18rpx;
  color: var(--color-title);
  font-size: 30rpx;
  font-weight: 600;
}

/* 提示文案 */
.kid-hint {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  gap: 6rpx;
  margin-top: 20rpx;
  padding: 0 40rpx;
}

.kid-hint-icon {
  display: flex;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.kid-hint-text {
  color: var(--color-kid-hint);
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}

/* 表单行 */
.kid-rows {
  margin: 36rpx 40rpx 0;
}

.kid-row {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  margin-bottom: 22rpx;
  padding: 0 32rpx;
  border-radius: 24rpx;
  background-color: var(--color-surface);
  box-shadow: 0 6rpx 20rpx var(--color-kid-shadow);
}

.kid-row-label {
  flex-shrink: 0;
  width: 150rpx;
  color: var(--color-title);
  font-size: 30rpx;
}

.kid-row-input {
  flex: 1;
  min-width: 0;
  height: 104rpx;
  color: var(--color-title);
  font-size: 30rpx;
  text-align: right;
}

.kid-placeholder {
  color: var(--color-placeholder);
  font-size: 28rpx;
}

.kid-row-value {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  min-width: 0;
}

.kid-row-text {
  color: var(--color-title);
  font-size: 30rpx;
  white-space: nowrap;
}

.kid-row-text-placeholder {
  color: var(--color-placeholder);
}

.kid-hint-birthday {
  margin-top: 4rpx;
  padding: 0 48rpx;
}

/* 底部保存按钮 */
.kid-cta-wrap {
  display: flex;
  justify-content: center;
  margin-top: auto;
  padding-top: 56rpx;
}

.kid-cta {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 260rpx;
  height: 112rpx;
  border-radius: 56rpx;
  background: linear-gradient(
    90deg,
    var(--color-kid-cta-start) 0%,
    var(--color-kid-cta-end) 100%
  );
  box-shadow: 0 14rpx 30rpx var(--color-kid-accent-soft);
}

.kid-cta-hover {
  opacity: 0.85;
}

.kid-cta-busy {
  opacity: 0.7;
}

.kid-cta-arrow {
  position: relative;
  width: 54rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background-color: var(--color-surface);
}

.kid-cta-arrow::after {
  content: "";
  position: absolute;
  right: 0;
  top: 50%;
  width: 18rpx;
  height: 18rpx;
  border-top: 4rpx solid var(--color-surface);
  border-right: 4rpx solid var(--color-surface);
  border-radius: 2rpx;
  transform: translateY(-50%) rotate(45deg);
}
