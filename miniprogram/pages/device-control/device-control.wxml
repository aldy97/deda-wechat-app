<view class="container device-control-page">
  <!-- 加载中 -->
  <view class="loading-wrap" wx:if="{{ loading }}">
    <van-loading type="spinner" size="48rpx">加载中...</van-loading>
  </view>

  <!-- 居中主控：顶部导航已展示「音量控制」，此处不再重复页面标题 -->
  <view wx:else class="content">
    <view class="volume-card">
      <view class="volume-status">
        <view class="status-dot status-dot--{{ deviceStatusTone }}"></view>
        <text class="status-text">{{ deviceStatusText }}</text>
      </view>

      <text class="volume-label">音量</text>

      <!-- 音量：契约 3.6 中唯一真实下发的控制项。只允许以 10 为步长；
           设备未上报音量时显示 --；离线或音量未知时两侧按钮禁用 -->
      <view class="volume-stepper">
        <view
          class="volume-step-btn {{ minusDisabled ? 'volume-step-btn--disabled' : '' }}"
          bind:tap="onVolumeMinus"
        >−</view>
        <view class="volume-display">
          <text class="volume-value">{{ volumeUnknown ? '--' : volume }}</text>
          <text class="volume-unit" wx:if="{{ !volumeUnknown }}">%</text>
        </view>
        <view
          class="volume-step-btn {{ plusDisabled ? 'volume-step-btn--disabled' : '' }}"
          bind:tap="onVolumePlus"
        >+</view>
      </view>

      <!-- 10 格刻度：每格 10%，直观展示当前档位 -->
      <view class="volume-meter">
        <view
          wx:for="{{ volumeDots }}"
          wx:key="id"
          class="meter-dot {{ item.on ? 'meter-dot--on' : '' }}"
        ></view>
      </view>

      <text class="volume-caption" wx:if="{{ statusHint }}">{{ statusHint }}</text>
    </view>

    <view class="actions">
      <van-button type="primary" block bind:click="onRefresh">
        刷新状态
      </van-button>
    </view>
  </view>
</view>
