.device-control-page {
  padding-bottom: 48rpx;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

/* 自绘音量步进器：交互上只允许以 10 为步长，音量未知时按钮禁用 */
.volume-stepper {
  display: flex;
  align-items: center;
}

.volume-step-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 50%;
  background-color: var(--color-surface);
  color: var(--color-primary);
  font-size: 34rpx;
  line-height: 1;
}

.volume-step-btn--disabled {
  border-color: var(--color-divider);
  background-color: var(--color-neutral-soft);
  color: var(--color-disabled);
}

.volume-value {
  min-width: 76rpx;
  margin: 0 20rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-heading);
}

.mode-card {
  padding: 28rpx;
  margin-top: 24rpx;
}

.mode-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.mode-title {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
}

.coming-soon-tag {
  font-size: 22rpx;
  color: var(--color-secondary);
  background-color: var(--color-neutral-soft);
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}

/* 离线 / 设备不存在提示 */
.status-hint {
  margin: 16rpx 32rpx 0;
}

.status-hint-text {
  font-size: 24rpx;
  color: var(--color-warning);
}

.actions {
  margin-top: 48rpx;
}

.current-mode-text {
  color: var(--color-success);
  font-weight: 600;
  font-size: 28rpx;
}
