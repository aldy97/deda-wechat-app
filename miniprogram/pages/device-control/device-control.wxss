.device-control-page {
  padding-bottom: 48rpx;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

.volume-slider {
  width: 320rpx;
}

.mode-card {
  padding: 28rpx;
  margin-top: 24rpx;
}

.mode-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.mode-title {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
}

.coming-soon-tag {
  font-size: 22rpx;
  color: var(--color-secondary);
  background-color: var(--color-neutral-soft);
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}

/* 离线 / 设备不存在提示 */
.status-hint {
  margin: 16rpx 32rpx 0;
}

.status-hint-text {
  font-size: 24rpx;
  color: var(--color-warning);
}

.actions {
  margin-top: 48rpx;
}

.current-mode-text {
  color: var(--color-success);
  font-weight: 600;
  font-size: 28rpx;
}
