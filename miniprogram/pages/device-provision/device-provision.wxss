.device-provision-page {
  padding: 40rpx;
}

.provision-header {
  margin-bottom: 40rpx;
}

.provision-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--color-title);
  margin-bottom: 16rpx;
}

.provision-subtitle {
  display: block;
  font-size: 28rpx;
  color: var(--color-body);
}

.step-card {
  padding: 40rpx 32rpx;
}

.step-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-heading);
  margin-bottom: 24rpx;
}

.step-body {
  margin-bottom: 40rpx;
}

.step-text {
  display: block;
  font-size: 28rpx;
  color: var(--color-text);
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.scanning-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
}

.scanning-text {
  margin-left: 16rpx;
  font-size: 26rpx;
}

.device-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 8rpx;
  border-bottom: 1rpx solid var(--color-divider);
}

.device-info {
  display: flex;
  flex-direction: column;
}

.device-name {
  font-size: 30rpx;
  color: var(--color-title);
}

.device-meta {
  font-size: 24rpx;
  margin-top: 8rpx;
}

.device-adv {
  font-size: 20rpx;
  color: var(--color-secondary);
  margin-top: 8rpx;
  word-break: break-all;
}

.diag-box {
  margin-top: 16rpx;
  padding: 16rpx;
  background: var(--color-bg);
  border-radius: 8rpx;
}

.device-arrow-icon {
  color: var(--color-placeholder);
}

.result-icon-success {
  color: var(--color-success);
}

.result-icon-warning {
  color: var(--color-warning);
}

.scan-empty {
  padding: 48rpx 0;
  text-align: center;
  font-size: 26rpx;
}

.error-text {
  color: var(--color-danger);
  font-size: 26rpx;
  margin: 24rpx 0;
}

.wifi-box {
  background: var(--color-brand-light);
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 32rpx;
}

.wifi-label {
  display: block;
  font-size: 24rpx;
  color: var(--color-body);
  margin-bottom: 8rpx;
}

.wifi-ssid {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-title);
  margin-bottom: 12rpx;
  word-break: break-all;
}

.wifi-tip {
  display: block;
  font-size: 24rpx;
  color: var(--color-warning);
  line-height: 1.5;
}

.step-actions {
  margin-top: 40rpx;
}

.step-actions van-button + van-button {
  margin-top: 24rpx;
}

.center-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 32rpx;
}

.provision-status {
  font-size: 30rpx;
  color: var(--color-text);
  margin: 32rpx 0 16rpx;
}

.result-text {
  font-size: 30rpx;
  color: var(--color-text);
  margin: 32rpx 0 16rpx;
  text-align: center;
  line-height: 1.6;
}
