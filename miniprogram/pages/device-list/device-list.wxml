<view class="device-list-page">
  <!-- 自定义导航栏：左侧添加设备圆形按钮，标题与按钮同排居中 -->
  <view class="device-nav" style="padding-top: {{ statusBarHeight }}px;">
    <view class="device-nav-bar" style="height: {{ navBarHeight }}px;">
      <view
        class="add-device-fab"
        bind:tap="onAddDevice"
        hover-class="add-device-fab-hover"
        aria-role="button"
        aria-label="添加设备"
      >
        <van-icon name="plus" size="32rpx" color="var(--color-primary)" />
      </view>
      <text class="device-nav-title">我的设备</text>
    </view>
  </view>

  <view class="container">
  <!-- 加载中 -->
  <view class="loading-wrap" wx:if="{{ loading }}">
    <van-loading type="spinner" size="48rpx">加载中...</van-loading>
  </view>

  <!-- 设备列表：空列表给空态引导，有设备时列表底部常驻「添加设备」 -->
  <view wx:else>
    <!-- 空态：无绑定设备 -->
    <view wx:if="{{ devices.length === 0 }}" class="card empty-device-card">
      <text class="empty-device-title">还没有绑定设备</text>
      <text class="empty-device-copy">输入设备底部的编码，完成绑定后开始使用。</text>
      <van-button type="primary" block bind:click="onAddDevice">去绑定</van-button>
    </view>

    <block wx:else>
    <view
      class="device-card card"
      wx:for="{{ devices }}"
      wx:key="id"
      data-id="{{ item.id }}"
    >
      <!-- 卡片顶部：状态/电量居左，孩子姓名居中，设置居右 -->
      <view class="card-top">
        <view class="status-battery-row">
          <!-- 状态标签：由 buildStatusTag 派生；加载中显示「连接中」，404 给「设备不存在」兜底 -->
          <view class="status-tag status-{{ item.statusTone }}">
            <text class="status-dot"></text>
            <text>{{ item.statusLabel }}</text>
          </view>

          <!-- 网络徽标：在线时常显网络类型（WiFi/4G）+ WiFi 信号格；离线/未知不渲染 -->
          <view
            wx:if="{{ !item.statusNotFound && item.networkBadge }}"
            class="network-badge network-{{ item.networkBadge.tone }}"
          >
            <view wx:if="{{ item.networkBadge.level !== null }}" class="signal-bars">
              <view class="signal-bar bar-1 {{ item.networkBadge.level >= 1 ? 'bar-on' : '' }}"></view>
              <view class="signal-bar bar-2 {{ item.networkBadge.level >= 2 ? 'bar-on' : '' }}"></view>
              <view class="signal-bar bar-3 {{ item.networkBadge.level >= 3 ? 'bar-on' : '' }}"></view>
            </view>
            <text class="network-badge-text">{{ item.networkBadge.text }}</text>
          </view>

          <!-- 电量加载中 -->
          <view class="battery-loading" wx:if="{{ item.statusLoading }}">
            <van-loading type="spinner" size="20rpx">电量...</van-loading>
          </view>

          <!-- 电量显示（isCharging 厂商契约 boolean|null，当前固件恒发 null，充电态分支保留不触发；404 设备不展示电量） -->
          <block wx:elif="{{ !item.statusNotFound }}">
            <view wx:if="{{ item.battery !== undefined && item.battery !== null }}" class="battery-wrap {{ item.isCharging ? 'battery-charging' : '' }}">
              <view class="battery-icon">
                <view class="battery-level" style="width: {{ item.battery }}%; background-color: {{ item.isCharging ? 'var(--color-primary)' : (item.battery >= 50 ? 'var(--color-success)' : (item.battery >= 20 ? 'var(--color-warning)' : 'var(--color-danger)')) }};"></view>
              </view>
              <text class="battery-text">{{ item.isCharging ? '⚡' : '' }}{{ item.battery }}%</text>
            </view>
            <!-- 设备尚未上报电量：显示 --，不按 0% 误导家长 -->
            <text wx:else class="battery-unknown-text">电量 --</text>
          </block>
        </view>

        <!-- 孩子姓名 -->
        <view class="child-name-top" bind:tap="onChildNameTap" data-id="{{ item.id }}">
          <block wx:if="{{ item.childProfile && (item.childProfile.name || item.childProfile.englishName) }}">
            <text class="child-name-cn">{{ item.childProfile.name || item.childProfile.englishName }}</text>
            <text class="child-name-en" wx:if="{{ item.childProfile.name && item.childProfile.englishName }}">{{ item.childProfile.englishName }}</text>
          </block>
          <block wx:else>
            <text class="child-name-empty">未设置孩子档案</text>
          </block>
        </view>

        <!-- 设置入口 -->
        <view class="settings-entry-right" bind:tap="onSettingsTap" data-id="{{ item.id }}">
          <van-icon name="setting-o" size="32rpx" color="var(--color-body)" />
          <text class="settings-text">设置</text>
        </view>
      </view>

      <!-- 卡片中部：只放今日数据与最近活跃；在线/离线等状态已在顶部 -->
      <view class="card-body" wx:if="{{ item.cardTitle || item.cardSubtitle || item.cardDesc || (!item.statusLoading && item.lastActiveText) }}">
        <view class="card-info">
          <view class="card-title-row" wx:if="{{ item.cardTitle }}">
            <text class="card-title">{{ item.cardTitle }}</text>
            <!-- <image class="title-icon" src="" mode="aspectFill" /> -->
          </view>
          <text class="card-subtitle" wx:if="{{ item.cardSubtitle }}">{{ item.cardSubtitle }}</text>
          <text class="card-desc" wx:if="{{ item.cardDesc }}">{{ item.cardDesc }}</text>
          <!-- 最近活跃时间；从未上报为「暂未连接」 -->
          <text class="last-active-text" wx:if="{{ !item.statusLoading && item.lastActiveText }}">{{ item.lastActiveText }}</text>
        </view>
      </view>

      <!-- 2026-11-25：对话记录功能暂时下线，卡片「查看对话」入口隐藏。
      恢复时放开本段，并补回 wxss 中 .card-actions / .action-btn / .action-icon / .action-text 样式。
      <view class="card-actions">
        <view class="action-btn" bind:tap="onViewChat" data-id="{{ item.id }}">
          <van-icon class="action-icon" name="chat-o" size="32rpx" color="var(--color-primary)" />
          <text class="action-text">查看对话</text>
        </view>
      </view>
      -->

      <!-- 卡片底部：查看成长报告（跳到「更懂TA」tab 并自动选中本设备） -->
      <view class="card-actions">
        <view class="action-btn" bind:tap="onViewReport" data-id="{{ item.id }}">
          <van-icon class="action-icon" name="chart-trending-o" size="32rpx" color="var(--color-primary)" />
          <text class="action-text">查看成长报告</text>
        </view>
      </view>
    </view>
    </block>
  </view>

  <!-- 来信反馈 banner：文案与版式由代码出，插画走远端展示位 device-list/feedback-hero；排在设备卡片之后 -->
  <view
    class="feedback-hero"
    bind:tap="onFeedbackHeroTap"
    hover-class="feedback-hero-hover"
    aria-role="button"
    aria-label="听风原野信箱：来信反馈产品问题或提出奇思妙想"
  >
    <view class="feedback-hero__copy">
      <text class="feedback-hero__title">听风原野信箱</text>
      <text class="feedback-hero__subtitle">欢迎来信反馈产品问题或提出奇思妙想</text>
      <view class="feedback-hero__desc-group">
        <text class="feedback-hero__desc">我们会第一时间帮您解决问题，</text>
        <text class="feedback-hero__desc">如果您的想法被采纳将会获赠最新推出的启智卡哟～</text>
      </view>
    </view>
    <elly-image
      class="feedback-hero__art"
      asset-key="device-list/feedback-hero"
      fallback="/static/images/kid-info/logo.png"
      mode="aspectFit"
      lazy-load="{{ false }}"
    />
  </view>
  </view>
</view>
