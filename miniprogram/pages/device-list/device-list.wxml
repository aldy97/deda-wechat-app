<view class="container device-list-page">
  <!-- 加载中 -->
  <view class="loading-wrap" wx:if="{{ loading }}">
    <van-loading type="spinner" size="48rpx">加载中...</van-loading>
  </view>

  <!-- 设备列表（联调简化版：固定只展示 DEV001） -->
  <view wx:else>
    <view
      class="device-card card"
      wx:for="{{ devices }}"
      wx:key="id"
      data-id="{{ item.id }}"
    >
      <!-- 卡片顶部：状态/电量居左，设置居右 -->
      <view class="card-top">
        <view class="status-battery-row">
          <!-- 状态标签 -->
          <view class="status-tag {{ item.status === 'online' ? 'status-online' : item.status === 'sleeping' ? 'status-sleeping' : 'status-offline' }}">
            <text class="status-dot"></text>
            <text>{{ item.status === 'online' ? '在线' : item.status === 'sleeping' ? '休眠' : '离线' }}</text>
          </view>

          <!-- 电量加载中 -->
          <view class="battery-loading" wx:if="{{ item.statusLoading }}">
            <van-loading type="spinner" size="20rpx">电量...</van-loading>
          </view>

          <!-- 电量显示 -->
          <view wx:elif="{{ item.battery !== undefined }}" class="battery-wrap {{ item.isCharging ? 'battery-charging' : '' }}">
            <view class="battery-icon">
              <view class="battery-level" style="width: {{ item.battery }}%; background-color: {{ item.isCharging ? '#4a90d9' : (item.battery >= 50 ? '#07c160' : (item.battery >= 20 ? '#ff976a' : '#ee0a24')) }};"></view>
            </view>
            <text class="battery-text">{{ item.isCharging ? '⚡' : '' }}{{ item.battery }}%</text>
          </view>
        </view>

        <!-- 设置入口 -->
        <view class="settings-entry-right" bind:tap="onSettingsTap" data-id="{{ item.id }}">
          <d-icon name="setting" size="32rpx" color="#999999"></d-icon>
          <text class="settings-text">设置</text>
        </view>
      </view>

      <!-- 卡片中部：标题、描述、当前模式 -->
      <view class="card-body">
        <view class="card-info">
          <view class="card-title-row">
            <text class="card-title">{{ item.cardTitle || 'DEDA AI 玩偶' }}</text>
            <image class="title-icon" src="" mode="aspectFill" />
          </view>
          <text class="card-desc">{{ item.cardDesc || 'DEDA AI 玩偶，随时在线陪伴孩子学习与成长。' }}</text>
          <view class="current-mode-row" wx:if="{{ item.currentMode }}">
            <text class="current-mode-label">当前模式：</text>
            <text class="current-mode-value">{{ item.currentMode }}</text>
            <text class="current-mode-detail" wx:if="{{ item.currentModeDetail }}">({{ item.currentModeDetail }})</text>
          </view>
        </view>
      </view>

      <!-- 卡片底部：三个按钮 -->
      <view class="card-actions">
        <view class="action-btn" bind:tap="onViewChat" data-id="{{ item.id }}">
          <d-icon class="action-icon" name="chat" size="32rpx" color="#4a90d9"></d-icon>
          <text class="action-text">查看对话</text>
        </view>
        <view class="action-btn" bind:tap="onViewAnalysis" data-id="{{ item.id }}">
          <d-icon class="action-icon" name="chart" size="32rpx" color="#4a90d9"></d-icon>
          <text class="action-text">智能分析</text>
        </view>
        <view class="action-btn" bind:tap="onSwitchMode" data-id="{{ item.id }}">
          <d-icon class="action-icon" name="swap" size="32rpx" color="#4a90d9"></d-icon>
          <text class="action-text">切换模式</text>
        </view>
      </view>
    </view>
  </view>
</view>
