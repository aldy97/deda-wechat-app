.device-list-page {
  padding-bottom: 48rpx;
  background-color: var(--color-bg);
  min-height: 100vh;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

/* 设备卡片 */
.device-card {
  position: relative;
  padding: 32rpx;
  margin-bottom: 32rpx;
  background: linear-gradient(
    135deg,
    var(--color-brand-light) 0%,
    var(--color-surface) 60%
  );
  border-radius: 24rpx;
  overflow: hidden;
}

/* 卡片顶部孩子姓名 */
.child-name-top {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex: 1;
  margin: 0 16rpx;
  min-width: 0;
}

.child-name-cn {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.child-name-en {
  font-size: 22rpx;
  color: var(--color-secondary);
  margin-left: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.child-name-empty {
  font-size: 24rpx;
  color: var(--color-secondary);
  white-space: nowrap;
}

/* 卡片顶部 */
.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.status-battery-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.status-tag {
  display: flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.status-online {
  color: var(--color-success);
  background-color: var(--color-success-soft);
}

.status-sleeping {
  color: var(--color-warning);
  background-color: var(--color-warning-soft);
}

.status-offline {
  color: var(--color-secondary);
  background-color: var(--color-neutral-soft);
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.status-online .status-dot {
  background-color: var(--color-success);
}

.status-sleeping .status-dot {
  background-color: var(--color-warning);
}

.status-offline .status-dot {
  background-color: var(--color-secondary);
}

/* 电量加载 */
.battery-loading {
  display: flex;
  align-items: center;
}

/* 电量显示 */
.battery-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.battery-icon {
  width: 36rpx;
  height: 18rpx;
  border: 2rpx solid var(--color-secondary);
  border-radius: 4rpx;
  padding: 2rpx;
  position: relative;
  box-sizing: border-box;
}

.battery-icon::after {
  content: "";
  position: absolute;
  right: -5rpx;
  top: 4rpx;
  width: 3rpx;
  height: 8rpx;
  background-color: var(--color-secondary);
  border-radius: 0 2rpx 2rpx 0;
}

.battery-level {
  height: 100%;
  border-radius: 2rpx;
  transition: width 0.3s ease;
}

.battery-charging .battery-icon {
  border-color: var(--color-primary);
}

.battery-charging .battery-icon::after {
  background-color: var(--color-primary);
}

.battery-text {
  font-size: 24rpx;
  color: var(--color-body);
}

.battery-charging .battery-text {
  color: var(--color-primary);
}

.settings-entry {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.settings-entry-right {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.settings-text {
  font-size: 24rpx;
  font-weight: bold;
  color: var(--color-secondary);
}

/* 卡片中部 */
.card-body {
  margin-bottom: 32rpx;
}

.card-info {
  flex: 1;
}

.card-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-right: 12rpx;
}

.title-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: var(--color-brand-light);
}

.card-subtitle {
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: 500;
  margin-bottom: 12rpx;
  display: block;
}

.card-desc {
  font-size: 26rpx;
  color: var(--color-body);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 卡片底部按钮 */
.card-actions {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  background-color: var(--color-brand-light);
  border-radius: 40rpx;
}

.action-icon {
  margin-right: 8rpx;
}

.action-text {
  font-size: 26rpx;
  color: var(--color-primary);
}

.current-mode-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  background-color: var(--color-success-soft);
  border-radius: 12rpx;
}

.current-mode-label {
  font-size: 26rpx;
  color: var(--color-body);
}

.current-mode-value {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-success);
  margin-left: 8rpx;
}

.current-mode-detail {
  font-size: 24rpx;
  color: var(--color-secondary);
  margin-left: 8rpx;
}
