.device-list-page {
  padding-bottom: 48rpx;
  background-color: #f5f6f8;
  min-height: 100vh;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

/* 设备卡片 */
.device-card {
  position: relative;
  padding: 32rpx;
  margin-bottom: 32rpx;
  background: linear-gradient(135deg, #e8f4ff 0%, #ffffff 60%);
  border-radius: 24rpx;
  overflow: hidden;
}

/* 卡片顶部 */
.card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.brand-row {
  display: flex;
  align-items: center;
}

.brand-name {
  font-size: 28rpx;
  color: #4a90d9;
  font-weight: 500;
  margin-right: 16rpx;
}

.status-tag {
  display: flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.status-online {
  color: #07c160;
  background-color: rgba(7, 193, 96, 0.1);
}

.status-offline {
  color: #4a90d9;
  background-color: rgba(74, 144, 217, 0.1);
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.status-online .status-dot {
  background-color: #07c160;
}

.status-offline .status-dot {
  background-color: #4a90d9;
}

.settings-entry {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.settings-text {
  font-size: 22rpx;
  color: #999999;
  margin-top: 4rpx;
}

/* 卡片中部 */
.card-body {
  display: flex;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.card-info {
  flex: 1;
  padding-right: 24rpx;
}

.card-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333333;
  margin-right: 12rpx;
}

.title-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: #e6f2ff;
}

.card-desc {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  background-color: #e6f2ff;
  flex-shrink: 0;
}

/* 卡片底部按钮 */
.card-actions {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  background-color: #f0f7ff;
  border-radius: 40rpx;
}

.action-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.action-text {
  font-size: 26rpx;
  color: #4a90d9;
}
