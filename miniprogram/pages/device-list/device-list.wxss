.device-list-page {
  padding-bottom: 48rpx;
  background-color: var(--color-bg);
  min-height: 100vh;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

/* 首页运营位通用容器：来信 banner 与哄睡入口共用布局，主类只声明底色 */
.hero-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 20rpx 24rpx 28rpx;
  margin-bottom: 32rpx;
  border-radius: 24rpx;
}

/* 来信反馈 banner：代码版式 + 插画槽位，配色只取色板变量 */
.feedback-hero {
  background: linear-gradient(
    135deg,
    var(--color-mode-5-soft) 0%,
    var(--color-surface) 68%
  );
}

/* 哄睡管理入口：深夜蓝底，右侧插画位暂留空，尺寸与 banner 等比 */
.sleep-manage-hero {
  background: linear-gradient(
    135deg,
    var(--color-sleep-deep) 0%,
    var(--color-sleep-deep-end) 100%
  );
}

.sleep-manage-hero__copy {
  flex: 1;
  min-width: 0;
}

.sleep-manage-hero__title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.2;
  color: var(--color-sleep-title);
}

.sleep-manage-hero__subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--color-sleep-subtitle);
}

/* 右侧插画：与 banner 插画同尺寸，换成远程展示位后版式不变 */
.sleep-manage-hero__art {
  flex-shrink: 0;
  display: block;
  width: 168rpx;
  height: 168rpx;
  margin-left: 16rpx;
}

.sleep-manage-hero-hover {
  opacity: 0.9;
}

.feedback-hero__copy {
  flex: 1;
  min-width: 0;
}

.feedback-hero__title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.2;
  color: var(--color-heading);
}

.feedback-hero__subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--color-mode-5);
}

.feedback-hero__desc-group {
  margin-top: 10rpx;
}

.feedback-hero__desc {
  display: block;
  font-size: 20rpx;
  line-height: 1.5;
  color: var(--color-body);
}

.feedback-hero__art {
  flex-shrink: 0;
  display: block;
  width: 168rpx;
  height: 168rpx;
  margin-left: 16rpx;
}

.feedback-hero-hover {
  opacity: 0.92;
}

/* 设备卡片 */
.device-card {
  position: relative;
  padding: 32rpx;
  margin-bottom: 32rpx;
  background: linear-gradient(
    135deg,
    var(--color-brand-light) 0%,
    var(--color-surface) 60%
  );
  border-radius: 24rpx;
  overflow: hidden;
}

/* 卡片顶部孩子姓名 */
.child-name-top {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex: 1;
  margin: 0 16rpx;
  min-width: 0;
}

.child-name-cn {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.child-name-en {
  font-size: 22rpx;
  color: var(--color-secondary);
  margin-left: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.child-name-empty {
  font-size: 24rpx;
  color: var(--color-secondary);
  white-space: nowrap;
}

/* 卡片顶部 */
.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.status-battery-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.status-tag {
  display: flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.status-online {
  color: var(--color-success);
  background-color: var(--color-success-soft);
}

.status-offline {
  color: var(--color-secondary);
  background-color: var(--color-neutral-soft);
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.status-online .status-dot {
  background-color: var(--color-success);
}

.status-offline .status-dot {
  background-color: var(--color-secondary);
}

/* 网络徽标：在线时常显网络类型 + WiFi 信号格 */
.network-badge {
  display: flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

/* 信号格：三格递升；点亮格用徽标自身色调（currentColor），未点亮格同色系低透明 */
.signal-bars {
  display: flex;
  align-items: flex-end;
  gap: 3rpx;
  margin-right: 6rpx;
}

.signal-bar {
  width: 5rpx;
  border-radius: 2rpx;
  background-color: currentColor;
  opacity: 0.25;
}

.signal-bar.bar-1 {
  height: 8rpx;
}

.signal-bar.bar-2 {
  height: 12rpx;
}

.signal-bar.bar-3 {
  height: 16rpx;
}

.signal-bar.bar-on {
  opacity: 1;
}

.network-badge-text {
  line-height: 1;
}

.network-neutral {
  color: var(--color-secondary);
  background-color: var(--color-neutral-soft);
}

.network-warning {
  color: var(--color-warning);
  background-color: var(--color-warning-soft);
}

.network-danger {
  color: var(--color-danger);
  background-color: var(--color-danger-bg);
}

/* 电量未知（设备未上报） */
.battery-unknown-text {
  font-size: 24rpx;
  color: var(--color-secondary);
}

/* 最近活跃时间 */
.last-active-text {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--color-secondary);
}

/* 电量加载 */
.battery-loading {
  display: flex;
  align-items: center;
}

/* 电量显示 */
.battery-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.battery-icon {
  width: 36rpx;
  height: 18rpx;
  border: 2rpx solid var(--color-secondary);
  border-radius: 4rpx;
  padding: 2rpx;
  position: relative;
  box-sizing: border-box;
}

.battery-icon::after {
  content: "";
  position: absolute;
  right: -5rpx;
  top: 4rpx;
  width: 3rpx;
  height: 8rpx;
  background-color: var(--color-secondary);
  border-radius: 0 2rpx 2rpx 0;
}

.battery-level {
  height: 100%;
  border-radius: 2rpx;
  transition: width 0.3s ease;
}

.battery-charging .battery-icon {
  border-color: var(--color-primary);
}

.battery-charging .battery-icon::after {
  background-color: var(--color-primary);
}

.battery-text {
  font-size: 24rpx;
  color: var(--color-body);
}

.battery-charging .battery-text {
  color: var(--color-primary);
}

.settings-entry {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.settings-entry-right {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.settings-text {
  font-size: 24rpx;
  font-weight: bold;
  color: var(--color-secondary);
}

/* 空态：无绑定设备 */
.empty-device-card {
  padding: 64rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-device-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 12rpx;
}

.empty-device-copy {
  font-size: 26rpx;
  color: var(--color-secondary);
  margin-bottom: 32rpx;
  text-align: center;
}

.empty-device-card van-button {
  width: 100%;
}

/* 自定义导航栏：左侧圆形添加按钮 + 居中标题 */
.device-nav {
  background-color: var(--color-bg);
}

.device-nav-bar {
  position: relative;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}

.device-nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  max-width: 50%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text);
}

/* 圆形添加设备入口（导航栏左侧） */
.add-device-fab {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin: 0;
  border-radius: 50%;
  background-color: var(--color-surface);
  border: 2rpx solid var(--color-border);
  box-shadow: 0 4rpx 16rpx var(--color-shadow);
}

.add-device-fab-hover {
  background-color: var(--color-brand-light);
}

/* 卡片中部 */
.card-body {
  margin-bottom: 32rpx;
}

.card-info {
  flex: 1;
}

.card-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-right: 12rpx;
}

.title-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: var(--color-brand-light);
}

.card-subtitle {
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: 500;
  margin-bottom: 12rpx;
  display: block;
}

.card-desc {
  font-size: 26rpx;
  color: var(--color-body);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 卡片底部按钮 */
.card-actions {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  background-color: var(--color-brand-light);
  border-radius: 40rpx;
}

.action-icon {
  margin-right: 8rpx;
}

.action-text {
  font-size: 26rpx;
  color: var(--color-primary);
}

.current-mode-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  background-color: var(--color-success-soft);
  border-radius: 12rpx;
}

.current-mode-label {
  font-size: 26rpx;
  color: var(--color-body);
}

.current-mode-value {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-success);
  margin-left: 8rpx;
}

.current-mode-detail {
  font-size: 24rpx;
  color: var(--color-secondary);
  margin-left: 8rpx;
}
