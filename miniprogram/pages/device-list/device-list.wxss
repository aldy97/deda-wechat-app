.device-list-page {
  padding-bottom: 48rpx;
  background-color: #f5f6f8;
  min-height: 100vh;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

/* 设备卡片 */
.device-card {
  position: relative;
  padding: 32rpx;
  margin-bottom: 32rpx;
  background: linear-gradient(135deg, #e8f4ff 0%, #ffffff 60%);
  border-radius: 24rpx;
  overflow: hidden;
}

/* 卡片顶部 */
.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.status-battery-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.status-tag {
  display: flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.status-online {
  color: #07c160;
  background-color: rgba(7, 193, 96, 0.1);
}

.status-sleeping {
  color: #ff976a;
  background-color: rgba(255, 151, 106, 0.1);
}

.status-offline {
  color: #969799;
  background-color: rgba(150, 151, 153, 0.1);
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.status-online .status-dot {
  background-color: #07c160;
}

.status-sleeping .status-dot {
  background-color: #ff976a;
}

.status-offline .status-dot {
  background-color: #969799;
}

/* 电量加载 */
.battery-loading {
  display: flex;
  align-items: center;
}

/* 电量显示 */
.battery-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.battery-icon {
  width: 36rpx;
  height: 18rpx;
  border: 2rpx solid #999999;
  border-radius: 4rpx;
  padding: 2rpx;
  position: relative;
  box-sizing: border-box;
}

.battery-icon::after {
  content: '';
  position: absolute;
  right: -5rpx;
  top: 4rpx;
  width: 3rpx;
  height: 8rpx;
  background-color: #999999;
  border-radius: 0 2rpx 2rpx 0;
}

.battery-level {
  height: 100%;
  border-radius: 2rpx;
  transition: width 0.3s ease;
}

.battery-charging .battery-icon {
  border-color: #4a90d9;
}

.battery-charging .battery-icon::after {
  background-color: #4a90d9;
}

.battery-text {
  font-size: 24rpx;
  color: #666666;
}

.battery-charging .battery-text {
  color: #4a90d9;
}

.settings-entry {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.settings-entry-right {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.settings-text {
  font-size: 24rpx;
  color: #999999;
}

/* 卡片中部 */
.card-body {
  margin-bottom: 32rpx;
}

.card-info {
  flex: 1;
}

.card-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333333;
  margin-right: 12rpx;
}

.title-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: #e6f2ff;
}

.card-subtitle {
  font-size: 28rpx;
  color: #4a90d9;
  font-weight: 500;
  margin-bottom: 12rpx;
  display: block;
}

.card-desc {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 卡片底部按钮 */
.card-actions {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  background-color: #f0f7ff;
  border-radius: 40rpx;
}

.action-icon {
  margin-right: 8rpx;
}

.action-text {
  font-size: 26rpx;
  color: #4a90d9;
}

.current-mode-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  background-color: rgba(7, 193, 96, 0.08);
  border-radius: 12rpx;
}

.current-mode-label {
  font-size: 26rpx;
  color: #666666;
}

.current-mode-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #07c160;
  margin-left: 8rpx;
}

.current-mode-detail {
  font-size: 24rpx;
  color: #999999;
  margin-left: 8rpx;
}
