.feedback-page {
  min-height: 100vh;
  padding: 32rpx 32rpx calc(192rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background-color: var(--color-surface);
}

/* 无设备提示条 */
.no-device-banner {
  background-color: var(--color-warning-bg);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.no-device-text {
  font-size: 26rpx;
  color: var(--color-warning);
  line-height: 1.5;
}

.field-label {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  color: var(--color-title);
  font-size: 32rpx;
  line-height: 48rpx;
}

.required-mark {
  margin-left: 6rpx;
  color: var(--color-accent);
}

.textarea-wrap {
  height: 320rpx;
  padding: 32rpx 32rpx 20rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background-color: var(--color-bg);
}

.feedback-textarea {
  width: 100%;
  height: 216rpx;
  color: var(--color-text);
  font-size: 32rpx;
  line-height: 48rpx;
}

.field-placeholder {
  color: var(--color-secondary);
}

.word-count {
  color: var(--color-placeholder);
  font-size: 26rpx;
  line-height: 40rpx;
  text-align: right;
}

.contact-group {
  margin-top: 48rpx;
}

.contact-input-wrap {
  display: flex;
  align-items: center;
  height: 112rpx;
  padding: 0 20rpx 0 32rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background-color: var(--color-bg);
}

.contact-input {
  flex: 1;
  min-width: 0;
  height: 100%;
  color: var(--color-text);
  font-size: 32rpx;
}

.phone-prefill-button {
  flex-shrink: 0;
  height: 64rpx;
  margin: 0 0 0 16rpx;
  padding: 0 12rpx;
  border-radius: 12rpx;
  background-color: transparent;
  color: var(--color-primary);
  font-size: 26rpx;
  line-height: 64rpx;
}

.phone-prefill-button::after {
  border: 0;
}

.phone-prefill-button[disabled] {
  background-color: transparent;
  color: var(--color-secondary);
  opacity: 1;
}

.submit-error {
  display: flex;
  align-items: flex-start;
  margin-top: 32rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background-color: var(--color-danger-bg);
}

.error-icon {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  margin-top: 2rpx;
  border-radius: 50%;
  background-color: var(--color-danger);
  color: var(--color-surface);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 36rpx;
}

.error-content {
  flex: 1;
  margin-left: 20rpx;
}

.error-title {
  color: var(--color-title);
  font-size: 30rpx;
  font-weight: 500;
  line-height: 42rpx;
}

.error-description {
  margin-top: 4rpx;
  color: var(--color-body);
  font-size: 26rpx;
  line-height: 40rpx;
}

.submit-button {
  position: fixed;
  right: 32rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  left: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 104rpx;
  padding: 0;
  border-radius: 52rpx;
  background-color: var(--color-primary);
  color: var(--color-surface);
  font-size: 34rpx;
  font-weight: 400;
  line-height: 104rpx;
  z-index: 10;
}

.submit-button::after {
  border: 0;
}

.submit-button[disabled] {
  background-color: var(--color-placeholder);
  color: var(--color-surface);
  opacity: 1;
}

.submit-button .wx-button-loading {
  margin-right: 12rpx;
}
