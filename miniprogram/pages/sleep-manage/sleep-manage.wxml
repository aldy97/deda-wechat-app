<kid-gradient-bg>
<view class="container sleep-manage-page">
  <!-- 页头「Elly + 对话气泡」：仅在绑定引导流程展示，日常设置不提示 -->
  <view class="sleep-hero" wx:if="{{ fromBind }}">
    <elly-bubble lines="{{ bubbleLines }}" />
  </view>

  <!-- 哄睡配置表单：与后续修改页共用 components/sleep-config-form -->
  <sleep-config-form device-id="{{ deviceId }}" />

  <!-- 绑定引导流程：完成并进入我的设备 -->
  <view
    wx:if="{{ fromBind }}"
    class="setup-finish"
    bind:tap="onFinish"
    hover-class="setup-finish-hover"
    aria-role="button"
    aria-label="完成哄睡设置"
  >完成</view>
</view>
</kid-gradient-bg>
