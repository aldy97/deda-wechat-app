page {
  background-color: var(--color-kid-bg-bottom);
}

.sleep-manage-page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 页头「Elly + 对话气泡」容器：视觉实现收在 components/elly-bubble */
.sleep-hero {
  padding: 8rpx 4rpx 0;
}

/* 绑定引导流程完成入口 */
.setup-finish {
  margin-top: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-surface);
  background: linear-gradient(
    90deg,
    var(--color-kid-cta-start) 0%,
    var(--color-kid-cta-end) 100%
  );
}

.setup-finish-hover {
  opacity: 0.9;
}
