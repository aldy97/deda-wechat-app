.switch-mode-page {
  min-height: 100vh;
  background-color: var(--color-bg);
  padding: 24rpx;
  box-sizing: border-box;
}

.mode-card {
  display: flex;
  align-items: center;
  padding: 32rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(
    135deg,
    var(--color-brand-light) 0%,
    var(--color-surface) 60%
  );
  border-radius: 24rpx;
}

.mode-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: var(--color-placeholder);
  margin-right: 32rpx;
  flex-shrink: 0;
}

.mode-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.mode-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 12rpx;
}

.mode-desc {
  font-size: 28rpx;
  color: var(--color-body);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.mode-card:active {
  transform: scale(0.97);
  background: var(--color-divider);
  transition: all 0.15s;
}

.mode-card.selected {
  border: 2rpx solid var(--color-success);
  background: var(--color-success-bg);
}

.selected-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: var(--color-success);
  color: var(--color-surface);
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.save-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: var(--color-overlay-light);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
