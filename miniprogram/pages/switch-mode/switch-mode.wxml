<view class="container switch-mode-page">
  <view class="loading-wrap" wx:if="{{ loading }}">
    <van-loading type="spinner" size="48rpx">加载中...</van-loading>
  </view>
  <view
    wx:if="{{ !loading }}"
    class="mode-card {{ currentMode === item.key ? 'selected' : '' }}"
    wx:for="{{ modes }}"
    wx:key="key"
    data-key="{{ item.key }}"
    bind:tap="onSelectMode"
  >
    <view class="mode-avatar"></view>
    <view class="mode-info">
      <text class="mode-title">{{ item.title }}</text>
      <text class="mode-desc">{{ item.description }}</text>
    </view>
    <view class="selected-icon" wx:if="{{ currentMode === item.key }}">✓</view>
  </view>

  <view class="save-overlay" wx:if="{{ saving }}">
    <van-loading type="spinner" size="48rpx">保存中…</van-loading>
  </view>
</view>
