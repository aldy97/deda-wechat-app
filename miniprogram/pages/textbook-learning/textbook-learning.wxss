.textbook-learning-page {
  min-height: 100vh;
  background-color: var(--color-bg);
  padding: 24rpx;
  box-sizing: border-box;
}

.textbook-card {
  display: flex;
  align-items: center;
  padding: 32rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(
    135deg,
    var(--color-brand-light) 0%,
    var(--color-surface) 60%
  );
  border-radius: 24rpx;
}

.textbook-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: var(--color-placeholder);
  margin-right: 32rpx;
  flex-shrink: 0;
}

.textbook-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.textbook-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 12rpx;
}

.textbook-desc {
  font-size: 28rpx;
  color: var(--color-body);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 80rpx 0;
}

.textbook-level {
  font-size: 24rpx;
  color: var(--color-primary);
  background-color: var(--color-brand-light);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  align-self: flex-start;
}
