.child-info-page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
  background-color: var(--color-bg);
}

.info-card,
.sleep-card,
.state-card {
  background-color: var(--color-surface);
  border-radius: 24rpx;
}

.info-card {
  padding: 0 32rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 116rpx;
  border-bottom: 1rpx solid var(--color-divider);
}

.info-row-last {
  border-bottom: 0;
}

.info-label {
  flex-shrink: 0;
  font-size: 30rpx;
  color: var(--color-title);
}

.info-value {
  max-width: 100%;
  font-size: 30rpx;
  color: var(--color-body);
  text-align: right;
}

.child-id-value {
  display: flex;
  align-items: flex-end;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.child-id {
  font-size: 26rpx;
  line-height: 1.4;
  word-break: break-all;
}

.copy-hint {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-placeholder);
}

.info-value-with-arrow {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.info-value-with-arrow .info-value {
  white-space: nowrap;
}

.sleep-card {
  padding: 32rpx;
  margin-top: 28rpx;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-title);
}

.section-description {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  color: var(--color-body);
}

.state-card {
  padding: 64rpx 32rpx;
  color: var(--color-secondary);
  font-size: 28rpx;
  text-align: center;
}
