<view class="container about-device-page">
  <!-- 加载中 -->
  <view class="loading-wrap" wx:if="{{ loading }}">
    <van-loading type="spinner" size="48rpx">加载中...</van-loading>
  </view>

  <!-- 空态：未取得设备信息 / 请求失败 -->
  <van-empty
    wx:elif="{{ sections.length === 0 }}"
    description="{{ loadFailed ? '加载失败，请稍后重试' : '暂无设备信息' }}"
  />

  <block wx:else>
    <!-- 三个分组：设备身份 / 运行状态 / 版本与环境 -->
    <van-cell-group
      wx:for="{{ sections }}"
      wx:key="key"
      inset
      title="{{ item.title }}"
      class="info-group"
    >
      <van-cell
        wx:for="{{ item.rows }}"
        wx:for-item="row"
        wx:key="key"
        title="{{ row.label }}"
        value="{{ row.value }}"
        value-class="info-value"
        is-link="{{ row.copyable }}"
        bind:click="onCopyRow"
        data-value="{{ row.copyable ? row.value : '' }}"
      />
    </van-cell-group>

    <view class="diagnostics-footer">
      <view class="diagnostics-actions">
        <van-button
          block
          size="small"
          loading="{{ refreshing }}"
          disabled="{{ refreshing }}"
          bind:click="onRefresh"
        >
          重新检测
        </van-button>
        <van-button block size="small" type="primary" bind:click="onCopyDiagnostics">
          复制诊断信息
        </van-button>
      </view>
      <text class="diagnostics-hint">反馈设备问题时，可截图本页或点击复制发给客服。</text>
    </view>
  </block>
</view>
