.about-device-page {
  min-height: 100vh;
  background-color: var(--color-bg);
  padding-top: 24rpx;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

.info-group {
  margin: 0 24rpx 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

/* 固件版本等长文本允许换行，避免撑破 cell；
   用 overflow-wrap 而不是 break-all：机型名只在单词边界断，不再把 iPhone1 / 6,1> 劈开 */
.info-value {
  max-width: 70%;
  overflow-wrap: anywhere;
  line-height: 1.4;
  text-align: right;
}

.diagnostics-footer {
  margin: 8rpx 24rpx 40rpx;
}

.diagnostics-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.diagnostics-hint {
  display: block;
  margin-top: 20rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--color-secondary);
  text-align: center;
}
