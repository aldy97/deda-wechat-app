<view class="container login-page">
  <view class="login-header">
    <text class="login-title">欢迎使用</text>
    <text class="login-subtitle">Deda 智能设备管理</text>
  </view>

  <view class="login-form card">
    <view class="login-actions">
      <van-button
        type="primary"
        block
        loading="{{ loading }}"
        loading-text="登录中..."
        disabled="{{ loading }}"
        bind:click="onLogin"
      >
        微信一键登录
      </van-button>
    </view>
  </view>

  <view class="login-tips text-secondary">使用微信身份登录，无需注册</view>
</view>
