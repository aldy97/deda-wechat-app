<view class="container device-setting-page">
  <!-- 第一组：关于设备、主人信息、说明书 -->
  <van-cell-group inset class="setting-group">
    <van-cell
      title="关于设备"
      is-link
      bind:click="onAboutDevice"
    />
    <van-cell
      title="主人信息"
      is-link
      bind:click="onOwnerInfo"
    />
    <van-cell
      title="说明书"
      is-link
      bind:click="onManual"
    />
  </van-cell-group>

  <!-- 第二组：重新联网 -->
  <van-cell-group inset class="setting-group">
    <van-cell
      title="重新联网"
      is-link
      bind:click="onReconnect"
    />
  </van-cell-group>

  <!-- 第三组：删除设备 -->
  <view class="delete-group">
    <view class="delete-btn" bind:tap="onDeleteDevice">
      <text class="delete-text">删除设备</text>
    </view>
  </view>

  <!-- 删除确认弹窗 -->
  <view class="modal-mask" wx:if="{{ showDeleteModal }}" bind:tap="onCancelDelete">
    <view class="modal-content" catch:tap="onModalTap">
      <view class="modal-title">温馨提示</view>
      <view class="modal-message">是否删除设备</view>
      <view class="modal-actions">
        <view class="modal-btn modal-cancel" bind:tap="onCancelDelete">
          <text>取消</text>
        </view>
        <view class="modal-divider"></view>
        <view class="modal-btn modal-confirm {{ deleteLoading ? 'modal-confirm-loading' : '' }}" bind:tap="onConfirmDelete">
          <van-loading wx:if="{{ deleteLoading }}" type="spinner" size="28rpx" color="#ee0a24" class="modal-loading" />
          <text class="{{ deleteLoading ? 'confirm-text-loading' : 'confirm-text' }}">{{ deleteLoading ? '删除中' : '确认' }}</text>
        </view>
      </view>
    </view>
  </view>
</view>
