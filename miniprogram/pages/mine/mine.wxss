.mine-page {
  min-height: 100vh;
  background-color: var(--color-bg);
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background-color: var(--color-surface);
  border-radius: 24rpx;
  margin-bottom: 24rpx;
}

/* 用户资料卡（loading / error / 正常三态共用同一尺寸） */
.profile-card {
  display: flex;
  align-items: center;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
}

.profile-card-hover {
  background-color: var(--color-bg);
}

.avatar-default {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: var(--color-divider);
  margin-right: 32rpx;
  flex-shrink: 0;
}

.avatar-skeleton {
  background-color: var(--color-divider);
}

.profile-info {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  justify-content: center;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 12rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.profile-meta {
  font-size: 26rpx;
  color: var(--color-secondary);
}

.profile-action {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 28rpx;
  color: var(--color-primary);
}

.profile-card-error {
  justify-content: center;
}

.profile-error-text {
  font-size: 30rpx;
  color: var(--color-body);
  margin-right: 12rpx;
}

/* 骨架条：与资料卡主/副文案同位置同尺寸 */
.skeleton-line {
  border-radius: 8rpx;
  background-color: var(--color-divider);
}

.skeleton-line-title {
  width: 240rpx;
  height: 32rpx;
  margin-bottom: 20rpx;
}

.skeleton-line-meta {
  width: 180rpx;
  height: 24rpx;
}

/* 菜单列表 */
.menu-list {
  padding: 0 32rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  min-height: 104rpx;
}

.menu-icon {
  width: 48rpx;
  margin-right: 24rpx;
  text-align: center;
  flex-shrink: 0;
}

.menu-text {
  flex: 1;
  font-size: 32rpx;
  color: var(--color-text);
}

.arrow-icon {
  flex-shrink: 0;
}
