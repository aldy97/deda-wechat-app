.mine-page {
  min-height: 100vh;
  background-color: #f5f6f8;
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background-color: #ffffff;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
}

/* 用户资料卡 */
.profile-card {
  display: flex;
  align-items: center;
  padding: 40rpx 32rpx;
}

.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: #e6e6e6;
  margin-right: 32rpx;
  flex-shrink: 0;
}

.profile-info {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.phone {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 12rpx;
}

.child-row {
  display: flex;
  align-items: center;
}

.child-name {
  font-size: 30rpx;
  color: #999999;
  margin-right: 4rpx;
}

/* 菜单列表 */
.menu-list {
  padding: 0 32rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
}

.menu-icon {
  margin-right: 24rpx;
  flex-shrink: 0;
}

.menu-text {
  flex: 1;
  font-size: 32rpx;
  color: #333333;
}

.arrow-icon {
  flex-shrink: 0;
}

.menu-divider {
  height: 1rpx;
  background-color: #f0f0f0;
  margin-left: 64rpx;
}
