.mine-page {
  min-height: 100vh;
  background-color: var(--color-bg);
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background-color: var(--color-surface);
  border-radius: 24rpx;
  margin-bottom: 24rpx;
}

/* 用户资料卡 */
.profile-card {
  display: flex;
  align-items: center;
  padding: 40rpx 32rpx;
}

.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: var(--color-placeholder);
  margin-right: 32rpx;
  flex-shrink: 0;
}

.profile-info {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.phone {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 12rpx;
}

.child-row {
  display: flex;
  align-items: center;
}

.child-name {
  font-size: 30rpx;
  color: var(--color-secondary);
  margin-right: 4rpx;
}

/* 菜单列表 */
.menu-list {
  padding: 0 32rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  min-height: 104rpx;
}

.menu-icon {
  width: 48rpx;
  margin-right: 24rpx;
  text-align: center;
  flex-shrink: 0;
}

.menu-text {
  flex: 1;
  font-size: 32rpx;
  color: var(--color-text);
}

.arrow-icon {
  flex-shrink: 0;
}
