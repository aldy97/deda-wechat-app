.container {
  padding: 24rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 80rpx 0;
}

.unit-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.unit-info {
  display: flex;
  flex-direction: column;
}

.unit-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.unit-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.unit-meta {
  display: flex;
  gap: 16rpx;
}

.unit-level,
.unit-difficulty {
  font-size: 24rpx;
  color: #1989fa;
  background-color: #e6f2ff;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}
