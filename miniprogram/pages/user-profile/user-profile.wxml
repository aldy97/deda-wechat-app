<kid-gradient-bg>
  <view class="profile-page" style="padding-top: {{ statusBarHeight }}px;">
    <view class="profile-nav" style="height: {{ navBarHeight }}px;">
      <view
        class="profile-back"
        bind:tap="onBack"
        hover-class="profile-back-hover"
        aria-role="button"
        aria-label="返回"
      >
        <van-icon name="arrow-left" size="44rpx" color="var(--color-title)" />
      </view>
      <text class="profile-nav-title">用户信息</text>
    </view>

    <view wx:if="{{ loading }}" class="profile-state">
      <van-loading type="spinner" size="48rpx" color="var(--color-kid-accent)">加载中...</van-loading>
    </view>

    <view wx:elif="{{ loadError }}" class="profile-state profile-state-error">
      <text class="profile-state-text">资料加载失败，请稍后重试</text>
      <view
        class="profile-retry"
        bind:tap="onRetryLoad"
        aria-role="button"
        aria-label="重新加载"
      >重新加载</view>
    </view>

    <block wx:else>
      <view class="profile-card">
        <view class="profile-row">
          <text class="profile-row-label">昵称</text>
          <input
            class="profile-row-input"
            type="nickname"
            maxlength="10"
            value="{{ form.nickname }}"
            placeholder="给自己起个昵称"
            placeholder-class="profile-placeholder"
            adjust-position="{{ true }}"
            cursor-spacing="24"
            bindinput="onNicknameChange"
          />
        </view>

        <view class="profile-row">
          <text class="profile-row-label">性别</text>
          <view class="profile-gender-group">
            <view
              class="profile-gender {{ form.gender === 'male' ? 'profile-gender-active' : '' }}"
              data-gender="male"
              bind:tap="onSelectGender"
              aria-role="button"
              aria-label="选择男"
            >男</view>
            <view
              class="profile-gender {{ form.gender === 'female' ? 'profile-gender-active' : '' }}"
              data-gender="female"
              bind:tap="onSelectGender"
              aria-role="button"
              aria-label="选择女"
            >女</view>
          </view>
        </view>

        <picker
          mode="date"
          start="1900-01-01"
          end="{{ today }}"
          value="{{ form.birthday || '1990-01-01' }}"
          bindchange="onBirthdayChange"
        >
          <view class="profile-row" aria-role="button" aria-label="选择生日">
            <text class="profile-row-label">生日</text>
            <view class="profile-row-value profile-row-value-row">
              <text
                class="profile-row-text {{ form.birthday ? '' : 'profile-row-text-placeholder' }}"
              >{{ form.birthday || '请选择生日' }}</text>
              <van-icon name="arrow" size="30rpx" color="var(--color-secondary)" />
            </view>
          </view>
        </picker>
      </view>

      <view class="profile-tip">昵称会用于 DEDA 对你的称呼，保存后可在「我的」页看到。</view>

      <view class="profile-cta-wrap">
        <view
          class="profile-cta {{ canSave && !saving ? '' : 'profile-cta-disabled' }}"
          bind:tap="onSave"
          hover-class="{{ canSave && !saving ? 'profile-cta-hover' : 'none' }}"
          aria-role="button"
          aria-disabled="{{ !canSave || saving }}"
          aria-label="保存昵称"
        >
          <van-loading
            wx:if="{{ saving }}"
            type="spinner"
            size="40rpx"
            color="var(--color-surface)"
          />
          <text wx:else>保存</text>
        </view>
      </view>
    </block>
  </view>
</kid-gradient-bg>
