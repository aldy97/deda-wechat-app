<view class="container device-analysis-page">
  <!-- 孩子档案头部 -->
  <view class="profile-header card">
    <view class="profile-skeleton" wx:if="{{ loading.profile }}">
      <van-skeleton row="2" title="{{ false }}" />
    </view>
    <view class="profile-info" wx:elif="{{ profile.name }}">
      <text class="child-name">{{ profile.name }}</text>
      <text class="child-meta text-secondary" wx:if="{{ profile.englishName }}">英文名 {{ profile.englishName }}</text>
      <text class="child-meta text-secondary" wx:else>暂无英文名</text>
    </view>
    <view class="profile-info" wx:else>
      <text class="child-name">未命名</text>
      <text class="child-meta text-secondary">暂无档案</text>
    </view>
  </view>

  <!-- 时间范围切换 -->
  <van-tabs active="{{ activeRange }}" bind:change="onRangeChange" custom-class="range-tabs">
    <van-tab name="today" title="今日"></van-tab>
    <van-tab name="week" title="本周"></van-tab>
    <van-tab name="month" title="本月"></van-tab>
  </van-tabs>

  <!-- 语境选择器：查看任何教材/单元/自由对话都是只读,不修改设备配置 -->
  <view class="context-bar" bind:tap="onOpenContextSheet">
    <van-icon name="records-o" size="28rpx" color="var(--color-primary)" />
    <text class="context-label">{{ contextLabel }}</text>
    <van-icon name="arrow-down" size="24rpx" color="var(--color-secondary)" />
  </view>
  <van-action-sheet
    show="{{ showContextSheet }}"
    actions="{{ contextActions }}"
    bind:select="onContextSelect"
    bind:close="onCloseContextSheet"
  />

  <!-- 核心指标卡 -->
  <view class="metrics-grid card">
    <block wx:if="{{ loading.metrics }}">
      <view class="metric-item" wx:for="{{ [1,2,3,4] }}" wx:key="*this">
        <van-skeleton row="1" row-width="60rpx" title="{{ false }}" />
        <van-skeleton row="1" row-width="80rpx" title="{{ false }}" />
      </view>
    </block>
    <block wx:else>
      <view class="metric-item">
        <text class="metric-value">{{ dashboard.totalDurationMinutes || 0 }}</text>
        <text class="metric-label text-secondary">学习时长(分)</text>
      </view>
      <view class="metric-item">
        <text class="metric-value">{{ practiceDisplay }}</text>
        <text class="metric-label text-secondary">练习次数</text>
      </view>
      <view class="metric-item">
        <text class="metric-value">{{ dashboard.continuousDays || 0 }}</text>
        <text class="metric-label text-secondary">连续天</text>
      </view>
      <view class="metric-item">
        <text class="metric-value">{{ dashboard.topicCount || 0 }}</text>
        <text class="metric-label text-secondary">主题数</text>
      </view>
    </block>
  </view>

  <!-- 学习趋势（今日=摘要卡 / 本周=7天柱 / 本月=周聚合柱） -->
  <view class="section card">
    <view class="section-title-row">
      <text class="section-title">学习趋势</text>
      <text class="trend-caption text-secondary">{{ trendCaption }}</text>
    </view>
    <view class="trend-skeleton" wx:if="{{ loading.trend }}">
      <van-skeleton row="1" row-width="100%" title="{{ false }}" />
    </view>
    <block wx:else>
      <view wx:if="{{ activeRange === 'today' }}" class="today-summary">
        <view class="today-metric">
          <text class="today-value">{{ todayMinutes }}</text>
          <text class="today-label text-secondary">今日时长(分)</text>
        </view>
        <view class="today-metric">
          <text class="today-value">{{ todaySessions }}</text>
          <text class="today-label text-secondary">今日对话(轮)</text>
        </view>
        <view class="today-metric">
          <text class="today-value">{{ dashboard.continuousDays || 0 }}</text>
          <text class="today-label text-secondary">连续学习(天)</text>
        </view>
      </view>
      <view class="trend-chart" wx:elif="{{ trendBars.length > 0 }}">
        <view class="trend-bar-wrap" wx:for="{{ trendBars }}" wx:key="label">
          <text class="trend-value" wx:if="{{ item.value > 0 }}">{{ item.value }}</text>
          <view class="trend-bar" style="height: {{ item.height }}rpx;"></view>
          <text class="trend-date">{{ item.label }}</text>
        </view>
      </view>
      <text wx:else class="empty-tip text-secondary">暂无趋势数据</text>
    </block>
  </view>

  <!-- 主题分布 -->
  <view class="section card">
    <text class="section-title">主题分布</text>
    <view class="topic-skeleton" wx:if="{{ loading.topics }}">
      <van-skeleton row="4" title="{{ false }}" />
    </view>
    <view class="topic-list" wx:elif="{{ topics.length > 0 }}">
      <view class="topic-item" wx:for="{{ topics }}" wx:key="id">
        <view class="topic-main">
          <text class="topic-name {{ item.isActive ? 'topic-active' : '' }}">
            {{ item.conversationModeName || item.textbookName || item.mode }}
            <text wx:if="{{ item.unitName }}"> · {{ item.unitName }}</text>
          </text>
          <van-tag wx:if="{{ item.isActive }}" type="success" size="medium">当前</van-tag>
        </view>
        <view class="topic-meta">
          <text class="topic-score text-secondary" wx:if="{{ item.avgScore != null }}">{{ item.avgScore }}分</text>
          <text class="topic-count text-secondary">{{ item.count }} 次对话</text>
        </view>
      </view>
    </view>
    <text wx:else class="empty-tip text-secondary">暂无主题数据</text>
  </view>

  <!-- 单元进度（自由对话语境下隐藏） -->
  <view class="section card" wx:if="{{ !isFreeChatContext }}">
    <text class="section-title">单元进度</text>
    <view class="unit-progress-skeleton" wx:if="{{ loading.unitProgress }}">
      <van-skeleton row="4" title="{{ false }}" />
    </view>
    <view class="unit-progress-list" wx:elif="{{ unitProgress.length > 0 }}">
      <view class="textbook-group" wx:for="{{ unitProgress }}" wx:key="textbookId">
        <text class="textbook-name">{{ item.textbookName }}</text>
        <view class="unit-list">
          <view class="unit-item" wx:for="{{ item.units }}" wx:for-item="unit" wx:key="unitId">
            <text class="unit-name">{{ unit.unitName }}</text>
            <text class="unit-count text-secondary">{{ unit.conversationCount }} 次对话</text>
          </view>
        </view>
      </view>
    </view>
    <text wx:else class="empty-tip text-secondary">暂无单元进度</text>
  </view>

  <!-- 学习动态（事件卡：练习/连续学习/解锁单元） -->
  <view class="section card">
    <text class="section-title">学习动态</text>
    <view class="timeline-skeleton" wx:if="{{ loading.activities }}">
      <van-skeleton row="4" title="{{ false }}" />
    </view>
    <block wx:elif="{{ activities.length > 0 }}">
      <view class="activity-day" wx:for="{{ activities }}" wx:key="date">
        <text class="activity-date">{{ item.date }}</text>
        <view
          class="activity-event"
          wx:for="{{ item.views }}"
          wx:for-item="ev"
          wx:key="text"
        >
          <van-icon name="{{ ev.icon }}" size="36rpx" color="var(--color-primary)" />
          <view class="activity-text-wrap">
            <text class="activity-text">{{ ev.text }}</text>
            <text class="activity-sub text-secondary" wx:if="{{ ev.sub }}">{{ ev.sub }}</text>
          </view>
        </view>
      </view>
    </block>
    <text wx:else class="empty-tip text-secondary">暂无学习动态</text>

    <van-button
      wx:if="{{ hasMore }}"
      type="default"
      block
      loading="{{ loading.activities }}"
      bind:click="onLoadMore"
    >
      加载更多
    </van-button>
    <text wx:elif="{{ activities.length > 0 }}" class="no-more text-secondary">没有更多了</text>
  </view>
</view>
