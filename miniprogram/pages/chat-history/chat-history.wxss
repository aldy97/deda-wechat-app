.chat-history-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f6f8;
}

/* 顶部上下文提示 */
.chat-context-hint {
  display: flex;
  justify-content: center;
  padding: 16rpx 32rpx;
  flex-shrink: 0;
}

.chat-context-hint text {
  font-size: 24rpx;
  color: #999999;
  text-align: center;
  line-height: 1.5;
}

/* 加载与空状态 */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}

/* 可滚动对话区域 */
.chat-scroll {
  flex: 1;
  overflow: hidden;
}

/* 顶部加载提示 */
.top-loading {
  display: flex;
  justify-content: center;
  padding: 24rpx 0;
}

.no-more-top {
  display: flex;
  justify-content: center;
  padding: 24rpx 0;
}

.no-more-top .text-secondary {
  font-size: 24rpx;
  color: #999999;
}

/* 对话列表 */
.chat-list {
  display: flex;
  flex-direction: column;
  padding: 0 24rpx 32rpx;
}

.chat-item {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-bottom: 32rpx;
  max-width: 100%;
}

.chat-item-left {
  align-items: flex-start;
}

.chat-item-right {
  align-items: flex-end;
}

/* 消息时间 */
.msg-time {
  display: flex;
  justify-content: center;
  width: 100%;
  margin-bottom: 24rpx;
}

.msg-time text {
  font-size: 24rpx;
  color: #999999;
  background-color: #e5e5e5;
  border-radius: 8rpx;
  padding: 6rpx 16rpx;
}

.bubble {
  max-width: 70%;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  word-break: break-word;
}

.bubble-device {
  background-color: #ffffff;
  border-top-left-radius: 4rpx;
}

.bubble-user {
  background-color: #8fc5ff;
  border-top-right-radius: 4rpx;
}

.bubble-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #333333;
}
