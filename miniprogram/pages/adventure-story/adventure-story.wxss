/* 页面底色跟随孩子场景的浅蓝渐变，回弹不露白 */
page {
  background-color: var(--color-kid-bg-bottom);
}

.adventure-story-page {
  min-height: 100vh;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 页头：与设备列表入口卡同一套薄荷绿渐变与插画 */
.adventure-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(
    135deg,
    var(--color-mode-2-soft) 0%,
    var(--color-surface) 68%
  );
  box-shadow: 0 4rpx 16rpx var(--color-shadow);
}

.adventure-hero__copy {
  flex: 1;
  min-width: 0;
}

.adventure-hero__eyebrow {
  display: block;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: var(--color-body);
}

.adventure-hero__title {
  display: block;
  margin-top: 8rpx;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.25;
  color: var(--color-heading);
}

.adventure-hero__subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--color-body);
}

.adventure-hero__art {
  flex-shrink: 0;
  display: block;
  width: 224rpx;
  height: 224rpx;
  margin-left: 16rpx;
}

/* 三张内容卡：沿用全局 .card 的白底与阴影，只补圆角与间距 */
.adventure-status,
.adventure-guide,
.adventure-section {
  margin: 24rpx 0 0;
  padding: 28rpx;
  border-radius: 24rpx;
}

.adventure-status__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.adventure-status__label {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-heading);
}

.adventure-status__value {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--color-success);
  background-color: var(--color-success-soft);
}

.adventure-status__main {
  display: block;
  margin-top: 20rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-heading);
}

.adventure-status__hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--color-body);
}

.adventure-guide__title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-heading);
}

.adventure-guide__label {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--color-body);
}

.adventure-guide__chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.adventure-guide__chip {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--color-primary);
  background-color: var(--color-brand-light);
}

.adventure-section__title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-heading);
}

.adventure-section__body {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--color-body);
}
