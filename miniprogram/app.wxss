@import "./styles/palette.wxss";

/* 全局样式：旧语义变量仅作为调色板别名保留 */
page {
  --primary-color: var(--color-primary);
  --success-color: var(--color-success);
  --warning-color: var(--color-warning);
  --danger-color: var(--color-danger);
  --text-color: var(--color-text);
  --text-color-secondary: var(--color-secondary);
  --background-color: var(--color-bg);

  font-family:
    -apple-system,
    BlinkMacSystemFont,
    "Helvetica Neue",
    Helvetica,
    Segoe UI,
    Arial,
    Roboto,
    "PingFang SC",
    "miui",
    "Hiragino Sans GB",
    "Microsoft Yahei",
    sans-serif;
  font-size: 28rpx;
  color: var(--color-text);
  background-color: var(--color-bg);
  line-height: 1.5;
}

/* 通用容器 */
.container {
  padding: 24rpx;
  box-sizing: border-box;
}

/* 卡片通用样式 */
.card {
  margin-bottom: 24rpx;
  background-color: var(--color-surface);
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx var(--color-shadow);
}

/* 页面标题 */
.page-title {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

/* 辅助文字 */
.text-secondary {
  color: var(--text-color-secondary);
  font-size: 24rpx;
}

/* 空状态占位 */
.empty-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
}
