.device-switch-wrap {
  position: relative;
  flex-shrink: 0;
}

.device-switch-wrap-open {
  z-index: 42;
}

.device-switch {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 128rpx;
  max-width: 220rpx;
  min-height: 72rpx;
  margin: 0;
  padding: 12rpx 20rpx;
  border: 0;
  border-radius: 36rpx;
  background: var(--color-brand-light);
  color: var(--color-primary);
  font-size: 24rpx;
  line-height: 1.3;
}

.device-switch::after {
  border: 0;
}

/* 孩子性别头像：胶囊里与菜单项里各一个尺寸 */
.device-switch__avatar {
  flex-shrink: 0;
  margin-right: 12rpx;
}

.device-switch-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 箭头形状与开合动画收在 components/expand-arrow，这里只管间距 */
.device-switch-arrow {
  margin-left: 12rpx;
}

.device-switch-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 40;
  background: transparent;
}

.device-dropdown {
  position: absolute;
  top: calc(100% + 8rpx);
  right: 0;
  z-index: 41;
  overflow: hidden;
  width: 264rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 20rpx;
  background: var(--color-surface);
  box-shadow: 0 16rpx 40rpx var(--color-shadow);
}

/* 胶囊贴在屏幕左侧时向左锚定，避免菜单溢出屏幕左边界 */
.device-dropdown--left {
  right: auto;
  left: 0;
}

.device-dropdown-item {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  color: var(--color-text);
  font-size: 28rpx;
}

.device-dropdown-item + .device-dropdown-item {
  border-top: 1rpx solid var(--color-divider);
}

.device-dropdown-item-hover {
  background: var(--color-bg);
}

.device-dropdown-main {
  display: flex;
  flex: 1;
  min-width: 0;
  align-items: center;
}

.device-dropdown-item__avatar {
  flex-shrink: 0;
  margin-right: 16rpx;
}

.device-dropdown-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 菜单底部的「添加设备」入口：与设备项同高，主色强调，始终排在最后 */
.device-dropdown-add {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  border-top: 1rpx solid var(--color-divider);
  color: var(--color-primary);
  font-size: 28rpx;
}

.device-dropdown-add__plus {
  flex-shrink: 0;
  width: 24rpx;
  margin-right: 16rpx;
  font-size: 34rpx;
  line-height: 1;
  text-align: center;
}

.device-dropdown-add__label {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
