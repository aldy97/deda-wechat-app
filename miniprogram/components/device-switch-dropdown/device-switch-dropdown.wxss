.device-switch-wrap {
  position: relative;
  flex-shrink: 0;
}

.device-switch-wrap-open {
  z-index: 42;
}

.device-switch {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 128rpx;
  max-width: 220rpx;
  min-height: 72rpx;
  margin: 0;
  padding: 12rpx 20rpx;
  border: 0;
  border-radius: 36rpx;
  background: var(--color-brand-light);
  color: var(--color-primary);
  font-size: 24rpx;
  line-height: 1.3;
}

.device-switch::after {
  border: 0;
}

.device-switch-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.device-switch-arrow {
  flex-shrink: 0;
  box-sizing: border-box;
  width: 12rpx;
  height: 12rpx;
  margin-left: 12rpx;
  border-right: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: translateY(-3rpx) rotate(45deg);
}

.device-switch-arrow-open {
  transform: translateY(3rpx) rotate(225deg);
}

.device-switch-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 40;
  background: transparent;
}

.device-dropdown {
  position: absolute;
  top: calc(100% + 8rpx);
  right: 0;
  z-index: 41;
  overflow: hidden;
  width: 264rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 20rpx;
  background: var(--color-surface);
  box-shadow: 0 16rpx 40rpx var(--color-shadow);
}

.device-dropdown-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  color: var(--color-text);
  font-size: 28rpx;
}

.device-dropdown-item + .device-dropdown-item {
  border-top: 1rpx solid var(--color-divider);
}

.device-dropdown-item-selected {
  background: var(--color-brand-light);
  color: var(--color-primary);
}

.device-dropdown-item-hover {
  background: var(--color-bg);
}

.device-dropdown-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.device-dropdown-check {
  flex-shrink: 0;
  margin-left: 16rpx;
  color: var(--color-primary);
  font-size: 30rpx;
  font-weight: 600;
}

/* 导航栏变体：与圆形「添加设备」按钮同一视觉体系（白底 + 描边 + 轻阴影） */
.variant-nav .device-switch {
  /* inline-flex 让宽度回到内容尺寸：块级 button 会被父容器 max-width 撑满，
     两个字的设备名也占满 230rpx，把居中的品牌 logo 挤到「+」按钮边上 */
  display: inline-flex;
  min-height: 64rpx;
  max-width: 260rpx;
  padding: 8rpx 20rpx;
  border: 2rpx solid var(--color-border);
  background: var(--color-surface);
  color: var(--color-text);
  box-shadow: 0 4rpx 16rpx var(--color-shadow);
}

/* 导航栏在屏幕左侧，菜单向左对齐更自然 */
.variant-nav .device-dropdown {
  right: auto;
  left: 0;
}
