/* 顶部总开关卡片 */
.header-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  background-color: var(--color-surface);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx var(--color-shadow);
}

.header-left {
  display: flex;
  align-items: center;
}

.header-icon {
  font-size: 44rpx;
  margin-right: 16rpx;
}

.header-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-title);
}

.header-right {
  display: flex;
  align-items: center;
}

.header-status {
  font-size: 26rpx;
  color: var(--color-secondary);
  margin-right: 16rpx;
}

/* 开关开启色：薰衣草紫 */
.sleep-switch {
  --switch-on-background-color: var(--color-mode-5);
}

/* 三张配置卡片 */
.card-row {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.cfg-card {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  background-color: var(--color-surface);
  border-radius: 24rpx;
  padding: 28rpx 20rpx;
  box-shadow: 0 4rpx 16rpx var(--color-shadow);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cfg-head {
  display: flex;
  align-items: center;
  align-self: flex-start;
}

.cfg-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  margin-right: 12rpx;
}

.cfg-icon-duration {
  background-color: var(--color-mode-5-soft);
}

.cfg-icon-content {
  background-color: var(--color-mode-4-soft);
}

.cfg-icon-time {
  background-color: var(--color-mode-2-soft);
}

.cfg-label {
  font-size: 26rpx;
  font-weight: 500;
}

.cfg-label-duration {
  color: var(--color-mode-5);
}

.cfg-label-content {
  color: var(--color-mode-4);
}

.cfg-label-time {
  color: var(--color-mode-2);
}

.cfg-value {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-title);
  margin: 32rpx 0;
}

.cfg-btn {
  width: 100%;
  box-sizing: border-box;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-surface);
}

.cfg-btn-duration {
  background-color: var(--color-mode-5);
}

.cfg-btn-content {
  background-color: var(--color-mode-4);
}

.cfg-btn-time {
  background-color: var(--color-mode-2);
}

/* 强制哄睡卡片 */
.force-card {
  margin-top: 24rpx;
  background-color: var(--color-surface);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx var(--color-shadow);
}

.force-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.force-left {
  display: flex;
  align-items: center;
}

.force-icon {
  width: 64rpx;
  height: 64rpx;
  font-size: 34rpx;
  margin-right: 16rpx;
}

.force-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-title);
}

.force-desc {
  display: block;
  margin-top: 24rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--color-body);
}

/* 如何进入哄睡模式（可展开） */
.guide-card {
  margin-top: 24rpx;
  background-color: var(--color-surface);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx var(--color-shadow);
}

.guide-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.guide-left {
  display: flex;
  align-items: center;
}

.guide-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background-color: var(--color-mode-3-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  margin-right: 16rpx;
}

.guide-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-title);
}

.guide-arrow {
  color: var(--color-secondary);
  font-size: 32rpx;
}

.guide-body {
  margin-top: 32rpx;
}

.guide-way {
  background-color: var(--color-bg);
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
}

.guide-way:last-child {
  margin-bottom: 0;
}

.way-head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.way-badge {
  background-color: var(--color-mode-5);
  color: var(--color-surface);
  font-size: 22rpx;
  font-weight: 500;
  border-radius: 10rpx;
  padding: 6rpx 16rpx;
  margin-right: 16rpx;
}

.way-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-mode-5);
}

.way-desc {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--color-body);
}

.way-desc-hl {
  color: var(--color-mode-5);
}

.chip-row {
  display: flex;
  gap: 20rpx;
  margin: 20rpx 0;
}

.chip {
  flex: 1;
  text-align: center;
  background-color: var(--color-mode-5-soft);
  color: var(--color-mode-5);
  font-size: 24rpx;
  border-radius: 999rpx;
  padding: 14rpx 0;
}

.way-time-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.way-time-left {
  display: flex;
  align-items: center;
}

.way-time-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.way-time {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-mode-5);
}

.way-modify {
  display: flex;
  align-items: center;
  background-color: var(--color-mode-5-soft);
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
}

.way-modify-text {
  font-size: 24rpx;
  color: var(--color-mode-5);
  margin-right: 8rpx;
}

.way-modify-arrow {
  color: var(--color-mode-5);
  font-size: 24rpx;
}

/* 时间选择弹窗 */
.time-picker {
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.picker-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 24rpx;
}

.picker-btn {
  flex: 1;
}

.picker-btn-cancel {
  background-color: var(--color-bg);
  color: var(--color-success);
  border: none;
}

.picker-btn-confirm {
  --button-primary-background-color: var(--color-success);
  --button-primary-border-color: var(--color-success);
}

/* 哄睡时长弹窗 */
.duration-panel {
  width: 640rpx;
  padding: 48rpx 40rpx 40rpx;
  box-sizing: border-box;
}

.duration-title {
  display: block;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-title);
  margin-bottom: 40rpx;
}

.duration-options {
  display: flex;
  gap: 24rpx;
}

.duration-option {
  flex: 1;
  min-width: 0;
  background-color: var(--color-bg);
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  padding: 40rpx 0 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.duration-option.active {
  background-color: var(--color-mode-5-soft);
  border-color: var(--color-mode-5);
}

.duration-option-icon {
  font-size: 48rpx;
  margin-bottom: 20rpx;
}

.duration-option-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-title);
  margin-bottom: 24rpx;
}

.duration-radio {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid var(--color-disabled);
  background-color: var(--color-surface);
  display: flex;
  align-items: center;
  justify-content: center;
}

.duration-radio.checked {
  border-color: var(--color-mode-5);
  background-color: var(--color-mode-5);
}

.duration-radio-check {
  color: var(--color-surface);
  font-size: 22rpx;
  line-height: 1;
}

/* 时长滑杆 */
.duration-slider-wrap {
  margin-top: 40rpx;
  padding: 0 8rpx;
}

.duration-slider {
  --slider-active-background-color: var(--color-mode-5);
  --slider-inactive-background-color: var(--color-disabled);
  --slider-button-background-color: var(--color-surface);
}

.duration-scale {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
}

.duration-scale-item {
  font-size: 24rpx;
  color: var(--color-secondary);
}

.duration-scale-item.active {
  color: var(--color-mode-5);
  font-weight: 600;
}

/* 提示框 */
.duration-note {
  margin-top: 40rpx;
  background-color: var(--color-mode-5-soft);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--color-body);
}

/* 确定按钮 */
.duration-confirm {
  margin-top: 40rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-surface);
  background-color: var(--color-mode-5);
}
