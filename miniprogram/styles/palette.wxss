/*
 * Deda / Elly 全局唯一色板。
 * 业务 WXSS、WXML、TS/JS 只能引用这里的变量；原生配置由 scripts/sync-palette.js 同步。
 */
page {
  /* 品牌与功能色 */
  --color-primary: #1a82fe;
  --color-brand: var(--color-primary);
  --color-brand-light: #edf2f6;
  --color-accent: #ca7764;
  --color-accent-dark: #a85444;
  --color-accent-bg: #faf0ed;
  --color-accent-text: #6f5a54;
  --color-pink: #efd0da;
  --color-pink-deep: #d9a5b5;
  --color-success: #07c160;
  --color-success-bg: #e6f7ed;
  --color-warning: #ff976a;
  --color-warning-bg: #faf0ed;
  --color-danger: #ee0a24;
  --color-danger-bg: #fef0f0;

  /* 中性色：相近灰阶已合并，正文与辅助信息分级使用 */
  --color-bg: #f7f8fa;
  --color-surface: #ffffff;
  --color-title: #202124;
  --color-heading: #252832;
  --color-text: #323233;
  --color-body: #626979;
  --color-secondary: #9298a6;
  --color-icon: #7c96a8;
  --color-border: #e9edf0;
  --color-divider: #f0f1f5;
  --color-disabled: #dfe2ea;
  --color-placeholder: #c9ced5;

  /* 阴影与遮罩 */
  --color-shadow: rgba(36, 40, 61, 0.04);
  --color-overlay: rgba(0, 0, 0, 0.5);
  --color-overlay-strong: rgba(0, 0, 0, 0.7);
  --color-overlay-light: rgba(255, 255, 255, 0.8);
  --color-success-soft: rgba(7, 193, 96, 0.1);
  --color-warning-soft: rgba(255, 151, 106, 0.1);
  --color-neutral-soft: rgba(150, 151, 153, 0.1);

  /* 功能模式色的柔和底色（图标圆底等场景） */
  --color-mode-2-soft: rgba(112, 214, 178, 0.16);
  --color-mode-3-soft: rgba(255, 209, 102, 0.25);
  --color-mode-4-soft: rgba(255, 158, 181, 0.18);
  --color-mode-5-soft: rgba(179, 157, 219, 0.18);

  /* 家长日报功能分布：明亮柔和的天空蓝、薄荷绿、向阳黄、樱花粉、薰衣草紫与蜜桃橙 */
  --color-mode-1: #6ec6ff;
  --color-mode-2: #70d6b2;
  --color-mode-3: #ffd166;
  --color-mode-4: #ff9eb5;
  --color-mode-5: #b39ddb;
  --color-mode-6: #ffbe76;

  /* 旧多设备趋势保留给未注册页面，顺序同样由此维护 */
  --color-trend-1: var(--color-success);
  --color-trend-2: var(--color-primary);
  --color-trend-3: var(--color-warning);
  --color-trend-4: var(--color-pink-deep);
  --color-trend-5: var(--color-danger);
  --color-trend-6: var(--color-icon);

  /* 孩子信息页（logo 小象蓝的欢快版本，沿用紫版的分段渐变方式） */
  --color-kid-bg-top: #8fb4d6;
  --color-kid-bg-mid: #c8e0f2;
  --color-kid-bg-bottom: #eaf5fc;
  --color-kid-accent: #5c8fc2;
  --color-kid-accent-soft: rgba(92, 143, 194, 0.22);
  --color-kid-cta-start: #5c8fc2;
  --color-kid-cta-end: #8fb4d6;
  --color-kid-hint: #6e8497;
  --color-kid-arrow: #a6c2d9;
  --color-kid-paw: rgba(255, 255, 255, 0.55);
  --color-kid-bubble: rgba(255, 255, 255, 0.86);
  --color-kid-shadow: rgba(51, 103, 153, 0.1);

  /* 哄睡入口：带困意的深夜蓝（首页哄睡管理 banner 专用） */
  --color-sleep-deep: #33415f;
  --color-sleep-deep-end: #222c45;
  --color-sleep-title: #f4f7fc;
  --color-sleep-subtitle: #c4cde1;
  /* 首页哄睡入口卡的深蓝渐变：比 hero 兜底更淡一档，避免整块读作近黑 */
  --color-sleep-card-start: #3c66a0;
  --color-sleep-card-end: #243f61;
  /* 晚安故事模式介绍页：hero 以下内容区与页面回弹的统一纯黑底 */
  --color-night-story-bg: #000000;
  /* 入口卡夜空装饰：月亮 / 星光 / 月亮光晕 + 更淡底色上的副标题 */
  --color-sleep-moon: #fdf3c8;
  --color-sleep-moon-glow: rgba(253, 243, 200, 0.35);
  --color-sleep-star: rgba(255, 255, 255, 0.9);
  --color-sleep-card-subtitle: #e6edf8;

  /* 哄睡配置页：hero 标签/遮罩与「了解更多哄睡的科学原理」banner */
  --color-sleep-pill-bg: rgba(255, 255, 255, 0.16);
  --color-sleep-pill-border: rgba(255, 255, 255, 0.45);
  --color-sleep-hero-mask-none: rgba(24, 20, 54, 0);
  --color-sleep-hero-mask-strong: rgba(24, 20, 54, 0.55);
  --color-sleep-science-start: #ff9ec7;
  --color-sleep-science-end: #ffd6ea;
  --color-sleep-science-badge: #ffd24d;
  --color-sleep-science-badge-text: #8a5b00;

  /* 冒险故事页：科学原理 banner 的森林绿渐变与太阳徽标 */
  --color-adventure-science-start: #2f7d5b;
  --color-adventure-science-end: #8fd9b6;
  --color-adventure-science-badge: #ffd166;
  --color-adventure-science-badge-text: #6b4a00;

  /* 冒险故事页：hero 顶部自定义返回键的深绿半透明胶囊 */
  --color-adventure-nav-pill-bg: rgba(20, 48, 36, 0.32);
  --color-adventure-nav-pill-border: rgba(255, 255, 255, 0.55);

  /* 冒险故事模式介绍页：hero 图向下延伸到正文的森林绿渐变 */
  --color-adventure-mode-bg-start: #2e5b46;
  --color-adventure-mode-bg-mid: #1d4032;
  --color-adventure-mode-bg-end: #122a20;

  /* 不支持 CSS 变量的原生配置由同步脚本读取 */
  --color-nav-bg: var(--color-surface);
  --color-tab-text: var(--color-secondary);
  --color-tab-active: var(--color-primary);
  --color-tab-bg: var(--color-surface);
}
